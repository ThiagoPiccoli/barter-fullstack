# Copie para .env.
#
# PostgreSQL. Local, com o cluster da própria máquina:
DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/barter_dev"
# Em produção, a URL do banco gerenciado — com TLS:
# DATABASE_URL="postgresql://usuario:senha@host:5432/barter?sslmode=require"
PORT=3333

# ── Produção ────────────────────────────────────────────────────────────────
# Com NODE_ENV=production o dataset de demonstração NÃO é carregado (ele criaria
# contas com senha pública). O primeiro acesso vem daqui, e a senha precisa ser
# trocada no primeiro login:
# NODE_ENV=production
# ADMIN_EMAIL=admin@suaempresa.com.br
# ADMIN_PASSWORD=troque-esta-senha-agora-mesmo
# ADMIN_NAME=Nome do Administrador
#
# A senha acima precisa passar na mesma política de todas as outras (ver
# src/auth/password-policy.ts): 10 caracteres no mínimo, fora da lista de
# senhas conhecidas, sem sequência de teclado e sem conter o nome do sistema.
#
# Perdeu a senha do admin? O admin não tem ninguém acima dele, então a saída é
# pela linha de comando, no servidor:
#   npm run password:reset                       # lista as contas
#   npm run password:reset -- admin@empresa.com  # sorteia uma senha provisória

# Origens liberadas no CORS (separadas por vírgula). Em produção, sem esta
# variável nenhuma origem externa é aceita. O app mobile não depende dela.
# CORS_ORIGINS=https://app.suaempresa.com.br

# A sessão morre de dois jeitos, e os dois importam.
#
# TOKEN_TTL_DAYS é o prazo ABSOLUTO: no máximo isto de vida, tenha sido usada ou
# não. TOKEN_IDLE_DAYS é a INATIVIDADE: sessão parada por este tanto morre, e é
# ela que resolve o aparelho perdido — sem ela, um celular esquecido no sábado
# continua sendo uma sessão válida por até um mês. Quem usa o app na rotina
# nunca chega perto do limite de inatividade.
# TOKEN_TTL_DAYS=30
# TOKEN_IDLE_DAYS=7

# Tentativas de login por minuto e por IP (padrão 10); teto geral por IP (600).
# LOGIN_RATE_LIMIT=10
# API_RATE_LIMIT=600

# Quantos proxies existem na FRENTE da API. Obrigatório se ela roda atrás de
# nginx, Cloudflare ou de um PaaS: sem isto o limite acima conta o IP do proxy,
# ou seja, todos os usuários somados disputam as mesmas 10 tentativas por
# minuto. Use o número de saltos (1 = um nginx à frente); `true` aceita a
# cadeia inteira e deixa qualquer um forjar o próprio IP. Sem proxy, não defina.
# TRUST_PROXY=1

# Custo do hash de senha (expoente do N do scrypt; padrão 16 ≈ 170ms por
# verificação). É de propósito que seja lento: é o que torna caro quebrar um
# hash vazado. Baixe SÓ em testes automatizados — o servidor avisa na subida se
# encontrar um valor abaixo do padrão. Senhas antigas são reescritas sozinhas
# no login quando este valor sobe, sem ninguém precisar trocar de senha.
# PASSWORD_COST=16

# Documentação navegável (Swagger) em /api/v1/docs. Ligada por padrão fora de
# produção; em produção fica fechada até você abrir de propósito.
# SWAGGER=on
