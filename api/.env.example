# Copie para .env — caminho do SQLite relativo à raiz do projeto (api/)
DATABASE_URL="file:./prisma/dev.db"
PORT=3333

# ── Produção ────────────────────────────────────────────────────────────────
# Com NODE_ENV=production o dataset de demonstração NÃO é carregado (ele criaria
# contas com senha pública). O primeiro acesso vem daqui, e a senha precisa ser
# trocada no primeiro login:
# NODE_ENV=production
# ADMIN_EMAIL=admin@suaempresa.com.br
# ADMIN_PASSWORD=troque-esta-senha
# ADMIN_NAME=Nome do Administrador

# Origens liberadas no CORS (separadas por vírgula). Em produção, sem esta
# variável nenhuma origem externa é aceita. O app mobile não depende dela.
# CORS_ORIGINS=https://app.suaempresa.com.br

# Validade da sessão em dias (padrão 30).
# TOKEN_TTL_DAYS=30

# Tentativas de login por minuto e por IP (padrão 10); teto geral por IP (600).
# LOGIN_RATE_LIMIT=10
# API_RATE_LIMIT=600

# Quantos proxies existem na FRENTE da API. Obrigatório se ela roda atrás de
# nginx, Cloudflare ou de um PaaS: sem isto o limite acima conta o IP do proxy,
# ou seja, todos os usuários somados disputam as mesmas 10 tentativas por
# minuto. Use o número de saltos (1 = um nginx à frente); `true` aceita a
# cadeia inteira e deixa qualquer um forjar o próprio IP. Sem proxy, não defina.
# TRUST_PROXY=1

# Senha provisória de vendedores criados pelo admin (padrão 123456). Vale uma
# única vez: o vendedor é obrigado a trocá-la ao entrar — e, até trocar, a API
# recusa todas as rotas de negócio (só /me, /auth/password e /auth/logout).
# SELLER_DEFAULT_PASSWORD=
