// Schema do Barter — permuta de grãos por insumos.
//
// Observações de domínio:
// - Os "enums" são String: role admin|consultant|manager|committee|biller,
//   type grain|input, kind grain|input, status sentToManager|pending|approved|denied,
//   ruleType none|percentOfTotal|valuePerHa. Vieram assim do SQLite, que não
//   tem enum, e continuam assim de propósito — a validação mora nos DTOs
//   (`@IsIn`) e um valor novo não pede migration nem deploy coordenado.
// - Permuta é registro HISTÓRICO: nomes/preços ficam desnormalizados
//   (snapshots) e os FKs usam SetNull para o histórico sobreviver a exclusões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Usuário que loga no app: admin (gerencia e revisa) ou consultant (consultor,
/// registra permutas para a própria carteira). Produtor NÃO é usuário.
model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("consultant")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// UNIDADE a que esta pessoa pertence (a lotação dela).
  ///
  /// Era `branch`, texto livre digitado no cadastro. Enquanto foi texto, "Filial
  /// 02", "filial 02" e "F02" eram três filiais para qualquer agrupamento, e não
  /// havia como perguntar "quem responde por esta unidade?" — que é justamente a
  /// pergunta do fluxo do gerente.
  unitId Int?
  unit   Unit? @relation("UserUnit", fields: [unitId], references: [id], onDelete: SetNull)

  /// O NOME da unidade no momento em que ele foi gravado.
  ///
  /// Continua existindo — e continua se chamando `branch` — porque é o rótulo
  /// que a permuta congela (`Barter.consultantBranch`), o que os rankings do
  /// painel agrupam e o que as permutas anteriores ao cadastro de unidades
  /// guardam. É snapshot pelo mesmo motivo de `Season.grainName`: excluir a
  /// unidade não pode apagar a memória de onde a pessoa estava. Quem escreve é
  /// um lugar só (user-provisioning.service.ts), a partir de `unit`.
  branch String?

  /// O GERENTE desta pessoa. Só o consultor tem, e para ele é obrigatório no
  /// cadastro (ver ConsultantDto): é a ele que as permutas do consultor são
  /// enviadas, e é ele quem escreve o parecer técnico delas.
  ///
  /// O vínculo é com a PESSOA, não com o lugar. A unidade de retirada é
  /// logística e não tem relação nenhuma com isto: uma permuta retirada na
  /// Filial 34 continua sendo analisada pelo gerente do consultor que a
  /// registrou.
  ///
  /// Nulável no banco porque os outros papéis não têm gerente — e porque a
  /// exclusão de um gerente precisa deixar os consultores dele órfãos em vez de
  /// apagá-los. Um consultor sem gerente não registra permuta até o admin
  /// designar outro.
  managerId Int?
  manager   User? @relation("ConsultantManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Senha provisória: o consultor recém-provisionado pelo admin precisa
  /// trocá-la antes de usar o app. O seed de demonstração nasce com false
  /// para o acesso rápido continuar direto.
  mustChangePassword Boolean @default(false)

  /// Tentativas de senha erradas SEGUIDAS. Zera no acerto; ao chegar no teto,
  /// a conta descansa (ver lockedUntil e MAX_FAILED_ATTEMPTS em auth.service).
  failedLoginAttempts Int @default(0)

  /// Até quando esta conta recusa tentativa de senha, mesmo a correta.
  ///
  /// O limite por IP sozinho não protege UMA conta: dez tentativas por minuto
  /// por IP viram muitas por minuto vindas de muitos IPs, e a conta do admin é
  /// alvo conhecido. Este campo é a trava do outro lado — por conta, não por
  /// origem.
  lockedUntil DateTime?

  tokens AccessToken[]

  /// A CARTEIRA desta pessoa — os vínculos com os produtores que ela atende.
  /// É lista de vínculos, não de produtores, porque o mesmo produtor pode estar
  /// na carteira de vários consultores (ver ProducerConsultant).
  wallet ProducerConsultant[]

  barters Barter[] @relation("ConsultantBarters")

  /// Os consultores sob a gerência desta pessoa (só gerente tem). É por aqui
  /// que a permuta chega até ele: ela é endereçada ao gerente de quem a
  /// registrou.
  team User[] @relation("ConsultantManager")

  /// As permutas endereçadas a este gerente, esperando ou já com parecer.
  opinions Barter[] @relation("ManagerOpinions")

  @@index([managerId])
}

/// Token de acesso opaco (guardamos só o SHA-256; o valor cru vai ao cliente).
/// Logout apaga a linha — revogação real no servidor.
model AccessToken {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Validade da sessão. O app guarda o token no aparelho entre aberturas,
  /// então ele precisa morrer sozinho: um token roubado vale no máximo até
  /// aqui, mesmo que ninguém faça logout. Ver TOKEN_TTL_DAYS.
  expiresAt DateTime

  /// Última vez que este token foi USADO — a segunda morte da sessão.
  ///
  /// O prazo absoluto acima resolve "esta sessão é velha demais"; ele não
  /// resolve o aparelho que sumiu do bolso na semana passada e cujo token ainda
  /// tem três semanas de vida. A inatividade resolve: sessão parada há
  /// TOKEN_IDLE_DAYS morre, e quem usa o app todo dia não é incomodado.
  ///
  /// A escrita é represada (ver TOUCH_INTERVAL_MS no AuthGuard): sem isso, toda
  /// requisição autenticada da API viraria também um UPDATE.
  lastUsedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([lastUsedAt])
}

/// UNIDADE: o lugar físico onde o produtor RETIRA os insumos da permuta.
///
/// É um LOCAL, e só. Ela não tem dono, não decide fluxo e não escolhe quem
/// analisa a permuta — quem dá o parecer é o gerente do CONSULTOR (ver
/// `User.managerId`), independentemente de onde a retirada acontece. O
/// consultor escolhe qualquer unidade da lista, inclusive uma de outra praça,
/// porque a retirada é decisão de logística combinada com o produtor.
///
/// Vale registrar por que ela existe como cadastro e não como texto: a filial
/// era digitada à mão, e "Filial 02", "filial 02" e "F02" eram três lugares
/// para qualquer agrupamento ou relatório.
model Unit {
  id   Int    @id @default(autoincrement())
  name String

  /// O mesmo nome reduzido à forma canônica (sem acento, sem caixa, sem espaço
  /// repetido). É ELE que carrega a unicidade, pelo mesmo motivo de
  /// `Producer.documentDigits`: sobre o texto cru, "Filial 02" e "FILIAL 02"
  /// passariam como duas unidades, e a mesma praça apareceria duas vezes na
  /// lista de retirada.
  nameKey String @unique

  /// Município/UF, como no produtor — é o que distingue duas unidades de nome
  /// parecido na hora de escolher onde retirar.
  city String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   User[]   @relation("UserUnit")
  barters Barter[]
}

/// Produtor (cliente) designado nas permutas; está na CARTEIRA de um ou mais
/// consultores (ver ProducerConsultant). Fica sem nenhum — aguardando
/// realocação — quando o último consultor vinculado é excluído.
model Producer {
  id           Int      @id @default(autoincrement())
  name         String
  /// CPF/CNPJ como o admin digitou — é o que aparece na tela e no comprovante.
  document     String
  /// O mesmo documento reduzido a dígitos. É ELE que carrega a unicidade:
  /// comparar o texto cru deixaria "CPF 123.456.789-00" e "12345678900"
  /// passarem como produtores diferentes, que é exatamente o cadastro em
  /// duplicidade que a regra existe para impedir.
  documentDigits String @unique
  phone        String?
  farmName     String
  city         String
  /// Área cultivável (ha): base das exigências mínimas por hectare.
  areaHa       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Os consultores que atendem este produtor. Quem escreve esta lista é o
  /// admin (ver CAPABILITY.producersManage).
  consultants ProducerConsultant[]

  barters Barter[]
}

/// O VÍNCULO entre um produtor e um consultor que o atende — a carteira, agora
/// como relação, e não como coluna.
///
/// Era `Producer.consultantId`: um produtor pertencia a exatamente uma
/// carteira. A operação não é assim — consultores dividem região, e o mesmo
/// produtor é atendido por mais de um. Com a coluna, o jeito de representar
/// isso era cadastrar o produtor duas vezes, e aí a área cultivável passava a
/// existir em dobro (os mínimos por hectare saem dela) e as permutas do mesmo
/// cliente se partiam entre dois registros — exatamente o que a unicidade de
/// `documentDigits` existe para impedir.
///
/// Os vínculos são IGUAIS entre si: não há dono nem principal. Qualquer
/// consultor vinculado enxerga o produtor e registra permuta para ele; a
/// permuta guarda quem a registrou (`Barter.consultantId`), que é onde a
/// pergunta "de quem foi esta venda?" se responde.
///
/// A exclusão é Cascade dos dois lados: sumindo o consultor, some o vínculo
/// dele — não o produtor. O produtor pode acabar sem nenhum consultor e ficar
/// esperando realocação, que é o mesmo estado que o antigo SetNull produzia.
model ProducerConsultant {
  producerId   Int
  producer     Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  consultantId Int
  consultant   User     @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  /// Desde quando este consultor atende este produtor. O vínculo tem data
  /// própria porque ele nasce depois do produtor: um compartilhamento feito
  /// hoje não deve parecer que existe desde o cadastro do cliente.
  assignedAt DateTime @default(now())

  @@id([producerId, consultantId])
  // A pergunta da listagem do consultor: "quais produtores são meus?".
  @@index([consultantId])
}

/// CLASSE do insumo — a taxonomia com que o FORNECEDOR organiza a lista de
/// preços (herbicidas, inseticidas, fungicidas, fertilizantes, fertilizantes
/// foliares, óleos e adjuvantes, inoculantes…).
///
/// A lista nasce do arquivo: a carga em massa cria a classe que ainda não
/// existe, e é assim que ela acompanha o fornecedor sem depender de migration.
/// O que NÃO existe é criar, renomear ou excluir classe pelo app — quem define
/// a taxonomia é a lista de preços, não quem cadastra.
///
/// O casamento é por nome normalizado (sem acento, sem caixa, sem espaço
/// repetido) ou pelo slug: é isso que impede "Defensivo", "DEFENSIVOS" e
/// "Defensivos Foliares" de virarem três classes medindo mínimos diferentes.
///
/// A REGRA de mínimo (percentOfTotal >= ruleValue % do custo, ou valuePerHa
/// >= R$ × área) é decisão comercial do admin e muda de safra para safra.
model ProductClass {
  id Int @id @default(autoincrement())

  /// Identificador estável da classe (`fungicidas`, `seguro-agricola`…). É por
  /// ele que a planilha e o código se referem a ela: o nome de exibição pode
  /// ser reescrito um dia, o slug não.
  slug String @unique
  name String

  /// Ordem de exibição — a lista tem um jeito certo de ser lida (do defensivo
  /// ao serviço), e ordenar por id ou por nome desmancharia isso.
  position Int @default(0)

  ruleType  String @default("none")
  ruleValue Float  @default(0)

  products Product[]
}

/// type=input: insumo retirado (forma o custo). type=grain: grão de pagamento.
///
/// O CADASTRO do produto mora aqui (nome, unidade, categoria, exigência por
/// hectare); o VALOR de troca não mora mais: ele pertence à versão do Barter
/// (ver VersionPrice e BarterVersion.grainPrice). `currentPrice` continua como
/// o último valor publicado — é o que alimenta o relatório de preço do produto
/// e a linha do tempo — mas quem precifica uma permuta é a versão vigente.
model Product {
  id            Int            @id @default(autoincrement())
  name          String
  unit          String
  type          String
  currentPrice  Float
  requiredPerHa Float          @default(0)
  classId       Int?
  productClass  ProductClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  /// Código do produto na planilha do fornecedor. É a chave de casamento da
  /// carga em massa: sem ele, "Ureia 45%" e "UREIA 45 %" viram dois cadastros a
  /// cada arquivo importado.
  sku String? @unique

  /// A UNIDADE deste item entrou como palpite e precisa de revisão.
  ///
  /// A lista de preços não tem coluna de unidade: a embalagem vem no fim da
  /// descrição (`emb.20 l`, `BIG-BAG`) e, quando ela não vem, no padrão da
  /// classe. Sobrando o que nem assim se resolve, o item entra com "unidade" e
  /// esta marca — que é o que permite achá-lo depois, em vez de a unidade
  /// errada aparecer no comprovante do produtor sem ninguém saber de onde veio.
  ///
  /// Some quando o admin escreve a unidade (ou quando uma carga seguinte
  /// consegue lê-la).
  unitPending Boolean @default(false)

  priceHistory  PriceHistoryEntry[]
  items         BarterItem[]
  versionPrices VersionPrice[]
  seasons       Season[]            @relation("SeasonGrain")
}

/// SAFRA (temporada): o Barter acontece SOBRE um grão, durante um ciclo.
/// `code` é a raiz do código das versões: letra do grão + ano (ex.: S2026 →
/// versões S2026.01, S2026.02...).
///
/// O grão fica desnormalizado (nome e unidade) porque a safra é registro
/// histórico: excluir o produto do catálogo não pode apagar a memória de que
/// aquela temporada era de soja.
model Season {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  year      Int
  grainId   Int?
  grain     Product? @relation("SeasonGrain", fields: [grainId], references: [id], onDelete: SetNull)
  grainName String
  grainUnit String
  status    String   @default("open")
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  versions BarterVersion[]
}

/// O BARTER LANÇADO — uma versão da safra (S2026.01, S2026.02...).
///
/// É ela que responde "com que valores se permuta hoje": o valor da saca do
/// grão e a tabela de preços dos insumos. Uma correção de valores no meio da
/// safra não reescreve a versão vigente — publica a próxima, e a anterior
/// fecha. É isso que mantém legível o que foi acordado em cada momento.
///
/// A VIGÊNCIA tem duas naturezas de propósito: `endsAt` é uma data que o admin
/// marcou e por isso TRAVA (a API recusa permuta depois dela); as metas abaixo
/// apenas medem — quem encerra por meta é o admin, para nada fechar sozinho de
/// madrugada. Ver isOpenAt() em version-progress.ts.
model BarterVersion {
  id       Int    @id @default(autoincrement())
  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number   Int
  code     String @unique
  status   String @default("active")

  /// Valor (R$) da saca do grão nesta versão — a taxa que converte o custo dos
  /// insumos em sacas. É digitado pelo admin ao publicar, não vem da planilha.
  grainPrice Float

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Metas de encerramento (null = sem meta). Medem o realizado das permutas
  /// APROVADAS da versão; ao atingir, o painel avisa e o admin decide.
  ///
  /// Não há meta de lucro: sem custo na lista de preços, ela seria a de vendas
  /// com outro nome.
  targetSales   Float?
  targetSacks   Float?
  targetBarters Int?

  /// De onde a tabela veio (nome do arquivo) e a observação do lançamento.
  sourceFile String?
  note       String?

  closedAt   DateTime?
  closedBy   String?
  closedById Int?

  prices  VersionPrice[]
  barters Barter[]

  @@unique([seasonId, number])
}

/// Uma LINHA da tabela de valores da versão: o preço de um insumo naquele
/// lançamento.
///
/// Não há custo aqui: a lista de preços do fornecedor traz o preço de venda, e
/// só. O Barter mede VENDAS — margem exigiria um dado que a operação não tem, e
/// um custo zerado faria "lucro" e "faturamento" mostrarem o mesmo número com
/// nomes diferentes.
///
/// Nome e unidade são snapshot pelo mesmo motivo do BarterItem: a tabela
/// precisa continuar legível depois que o produto sair do catálogo.
model VersionPrice {
  id          Int           @id @default(autoincrement())
  versionId   Int
  version     BarterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unit        String
  price       Float

  @@unique([versionId, productId])
}

/// Linha do tempo dos reajustes. changedBy desnormalizado: o histórico
/// sobrevive à exclusão do usuário.
model PriceHistoryEntry {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Float
  changedBy   String
  changedById Int?
  changedAt   DateTime
}

/// Permuta: insumos retirados formam um custo, pago com o grão da safra, cujas
/// sacas são calculadas pelo servidor. `code` (PRM-AAAA-NNN) é o id público.
///
/// Toda permuta nasce DENTRO de uma versão do Barter — é ela que diz por quais
/// valores esta permuta foi fechada. `versionCode` fica desnormalizado porque é
/// o que aparece no detalhe e no comprovante: o documento precisa dizer em qual
/// gestão o acordo foi feito, mesmo que a versão seja removida do banco.
///
/// O CAMINHO dela é o `status`, e ele tem quatro paradas:
///
///     sentToManager → pending → approved
///                             ↘ denied
///
/// `sentToManager` é onde ela nasce: o consultor a registrou e ela está na mesa
/// do GERENTE DELE, esperando o parecer técnico. Escrito o parecer, ela vira
/// `pending` — a fila de REVISÃO, onde alguém aprova ou nega (hoje o admin;
/// comitê e faturista entram nas próximas etapas do fluxo).
///
/// "Revisão" e não "análise" é a palavra do sistema para esta etapa: a rota é
/// `POST /barters/:code/review` e os campos são `reviewedBy`/`reviewedAt`. O
/// gerente também analisa — chamar as duas coisas de análise deixava as etapas
/// indistinguíveis no vocabulário.
model Barter {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  versionId        Int?
  version          BarterVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  versionCode      String         @default("")
  consultantId     Int?
  consultant       User?          @relation("ConsultantBarters", fields: [consultantId], references: [id], onDelete: SetNull)
  producerId       Int?
  producer         Producer?      @relation(fields: [producerId], references: [id], onDelete: SetNull)
  consultantName   String
  consultantBranch String         @default("")
  producerName     String

  /// UNIDADE DE RETIRADA — onde o produtor busca os insumos desta permuta.
  ///
  /// É LOGÍSTICA, e nada além disso: ela não escolhe quem analisa a permuta nem
  /// participa de nenhuma regra. O consultor pode mandar a retirada para
  /// qualquer unidade, inclusive uma de outra praça, e o parecer continua sendo
  /// do gerente dele. `unitName` é o snapshot para o detalhe e o comprovante,
  /// pelo mesmo motivo de `producerName`.
  unitId   Int?
  unit     Unit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitName String @default("")

  status String @default("sentToManager")

  /// O IMPOSTO DA ENTREGA — a entrega de grão é comercialização de produção
  /// rural, e sobre ela incidem o Funrural e o Senar.
  ///
  /// `taxRegime` é a FORMA escolhida no fechamento desta permuta:
  /// `comercializacao` (sobre a receita da venda) ou `folha` (sobre a folha de
  /// pagamento — e aí sobre a entrega fica só o Senar). Ver
  /// `src/barters/tax-regime.ts`.
  ///
  /// `taxRate` é a alíquota (%) que essa escolha produziu, e é SNAPSHOT pelo
  /// mesmo motivo de `producerName` e do preço do item: a alíquota muda por lei
  /// (a atual vale desde 1º/04/2026) e o que decide qual vale é a data da
  /// comercialização. Recalculando na leitura, um comprovante emitido depois da
  /// lei seguinte passaria a mostrar um imposto diferente do que foi acordado.
  ///
  /// `taxRate` 0 nas permutas anteriores a estes campos: elas não têm alíquota
  /// registrada, e inventar uma seria afirmar um número que ninguém aplicou.
  taxRegime String @default("comercializacao")
  taxRate   Float  @default(0)

  /// O GERENTE A QUEM ESTA PERMUTA FOI ENVIADA — o gerente do consultor no
  /// momento do registro — e o parecer técnico dele sobre a negociação.
  ///
  /// O destinatário é gravado no ENVIO, não lido do vínculo atual. É a leitura
  /// literal de "o consultor envia para o gerente": trocar o gerente de um
  /// consultor vale para as próximas permutas, e as que já estão na mesa de
  /// alguém continuam lá. O contrário faria uma permuta mudar de mãos sem
  /// ninguém ter agido sobre ela.
  ///
  /// O parecer é texto, e só texto: ele não aprova nem nega — quem decide é a
  /// instância seguinte, que o lê antes. Escrevê-lo é o que move a permuta de
  /// `sentToManager` para `pending`.
  ///
  /// `managerName` é snapshot (o parecer precisa continuar assinado depois que
  /// a conta for excluída); `managerId` fica como pista, com SetNull.
  managerId         Int?
  manager           User?     @relation("ManagerOpinions", fields: [managerId], references: [id], onDelete: SetNull)
  managerName       String?
  managerNote       String?
  managerReviewedAt DateTime?

  adminNote    String?
  reviewedBy   String?
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  items BarterItem[]

  @@index([versionId])
  @@index([unitId])
  // A fila do gerente: as permutas endereçadas a ele que ainda esperam parecer.
  @@index([managerId, status])
}

/// Item da permuta com snapshots imutáveis de nome/unidade/preço. O preço é
/// congelado aqui — e não lido da tabela da versão — porque publicar a versão
/// seguinte não pode reescrever o que já foi acordado.
model BarterItem {
  id          Int      @id @default(autoincrement())
  barterId    Int
  barter      Barter   @relation(fields: [barterId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind        String
  productName String
  unit        String
  quantity    Float
  unitValue   Float
}

/// Trilha de AUDITORIA dos atos sensíveis: quem provisionou, redefiniu senha,
/// excluiu usuário e quem decidiu permuta.
///
/// Existe porque redefinir senha é a primitiva de tomada de conta do sistema:
/// ela sorteia uma senha nova e derruba as sessões abertas do titular. Sem
/// registro, uma sessão de admin comprometida faria isso com qualquer usuário
/// e não sobraria como reconstruir o que aconteceu — o log HTTP vai para a
/// saída padrão, é volátil e nem sabe QUEM chamou.
///
/// Tudo aqui é SNAPSHOT em texto, não relação: a linha precisa continuar
/// legível depois que o autor ou o alvo forem excluídos, que é justamente o
/// caso em que alguém vai querer lê-la. Os ids ficam só como pista.
model AuditLog {
  id Int @id @default(autoincrement())

  /// Quem praticou o ato, congelado no momento em que ele aconteceu.
  actorId    Int?
  actorName  String
  actorRole  String

  /// O que foi feito — ver AUDIT_ACTION em src/audit/audit.service.ts.
  action String

  /// Sobre quem/o quê, também congelado ("user" | "barter" | "unit" | …).
  targetType  String
  targetId    Int?
  targetLabel String

  /// Contexto curto e legível do ato (ex.: papel provisionado, decisão tomada).
  detail String?

  at DateTime @default(now())

  @@index([at])
  @@index([targetType, targetId])
}
