// Schema do Barter — permuta de grãos por insumos.
//
// Observações de domínio (mesmas regras da versão anterior):
// - Enums viram String (SQLite não tem enum): role admin|consultant,
//   type grain|input, kind grain|input, status pending|approved|denied,
//   ruleType none|percentOfTotal|valuePerHa.
// - Permuta é registro HISTÓRICO: nomes/preços ficam desnormalizados
//   (snapshots) e os FKs usam SetNull para o histórico sobreviver a exclusões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Usuário que loga no app: admin (gerencia e revisa) ou consultant (consultor,
/// registra permutas para a própria carteira). Produtor NÃO é usuário.
model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("consultant")
  phone     String?
  branch    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Senha provisória: o consultor recém-provisionado pelo admin precisa
  /// trocá-la antes de usar o app. O seed de demonstração nasce com false
  /// para o acesso rápido continuar direto.
  mustChangePassword Boolean @default(false)

  tokens  AccessToken[]
  wallet  Producer[]
  barters Barter[]      @relation("ConsultantBarters")
}

/// Token de acesso opaco (guardamos só o SHA-256; o valor cru vai ao cliente).
/// Logout apaga a linha — revogação real no servidor.
model AccessToken {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Validade da sessão. O app guarda o token no aparelho entre aberturas,
  /// então ele precisa morrer sozinho: um token roubado vale no máximo até
  /// aqui, mesmo que ninguém faça logout. Ver TOKEN_TTL_DAYS.
  expiresAt DateTime

  @@index([expiresAt])
}

/// Produtor (cliente) designado nas permutas; pertence à CARTEIRA de um
/// consultor. consultantId vira NULL se o consultor for excluído (aguarda realocação).
model Producer {
  id           Int      @id @default(autoincrement())
  name         String
  consultantId Int?
  consultant   User?    @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  /// CPF/CNPJ como o admin digitou — é o que aparece na tela e no comprovante.
  document     String
  /// O mesmo documento reduzido a dígitos. É ELE que carrega a unicidade:
  /// comparar o texto cru deixaria "CPF 123.456.789-00" e "12345678900"
  /// passarem como produtores diferentes, que é exatamente o cadastro em
  /// duplicidade que a regra existe para impedir.
  documentDigits String @unique
  phone        String?
  farmName     String
  city         String
  /// Área cultivável (ha): base das exigências mínimas por hectare.
  areaHa       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barters Barter[]
}

/// "Pasta" de insumos; a regra de mínimo vigente trava o envio da permuta:
/// percentOfTotal (>= ruleValue % do custo) ou valuePerHa (>= R$ × área).
model InputCategory {
  id        Int    @id @default(autoincrement())
  name      String
  ruleType  String @default("none")
  ruleValue Float  @default(0)

  products Product[]
}

/// type=input: insumo retirado (forma o custo). type=grain: grão de pagamento.
/// currentPrice é o valor de referência do admin — a "taxa de câmbio".
model Product {
  id            Int            @id @default(autoincrement())
  name          String
  unit          String
  type          String
  currentPrice  Float
  requiredPerHa Float          @default(0)
  categoryId    Int?
  category      InputCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  priceHistory PriceHistoryEntry[]
  items        BarterItem[]
}

/// Linha do tempo dos reajustes. changedBy desnormalizado: o histórico
/// sobrevive à exclusão do usuário.
model PriceHistoryEntry {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Float
  changedBy   String
  changedById Int?
  changedAt   DateTime
}

/// Permuta: insumos retirados formam um custo, pago com UM grão cujas sacas
/// são calculadas pelo servidor. `code` (PRM-AAAA-NNN) é o id público.
model Barter {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  consultantId     Int?
  consultant       User?     @relation("ConsultantBarters", fields: [consultantId], references: [id], onDelete: SetNull)
  producerId       Int?
  producer         Producer? @relation(fields: [producerId], references: [id], onDelete: SetNull)
  consultantName   String
  consultantBranch String    @default("")
  producerName     String
  status           String    @default("pending")
  adminNote        String?
  reviewedBy       String?
  reviewedById     Int?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  items BarterItem[]
}

/// Item da permuta com snapshots imutáveis de nome/unidade/preço.
model BarterItem {
  id          Int      @id @default(autoincrement())
  barterId    Int
  barter      Barter   @relation(fields: [barterId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind        String
  productName String
  unit        String
  quantity    Float
  unitValue   Float
}

/// Trilha de AUDITORIA dos atos sensíveis: quem provisionou, redefiniu senha,
/// excluiu usuário e quem decidiu permuta.
///
/// Existe porque redefinir senha é a primitiva de tomada de conta do sistema:
/// ela sorteia uma senha nova e derruba as sessões abertas do titular. Sem
/// registro, uma sessão de admin comprometida faria isso com qualquer usuário
/// e não sobraria como reconstruir o que aconteceu — o log HTTP vai para a
/// saída padrão, é volátil e nem sabe QUEM chamou.
///
/// Tudo aqui é SNAPSHOT em texto, não relação: a linha precisa continuar
/// legível depois que o autor ou o alvo forem excluídos, que é justamente o
/// caso em que alguém vai querer lê-la. Os ids ficam só como pista.
model AuditLog {
  id Int @id @default(autoincrement())

  /// Quem praticou o ato, congelado no momento em que ele aconteceu.
  actorId    Int?
  actorName  String
  actorRole  String

  /// O que foi feito — ver AUDIT_ACTION em src/audit/audit.service.ts.
  action String

  /// Sobre quem/o quê, também congelado ("user" | "barter").
  targetType  String
  targetId    Int?
  targetLabel String

  /// Contexto curto e legível do ato (ex.: papel provisionado, decisão tomada).
  detail String?

  at DateTime @default(now())

  @@index([at])
  @@index([targetType, targetId])
}
