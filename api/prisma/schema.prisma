// Schema do Barter — permuta de grãos por insumos.
//
// Observações de domínio:
// - Os "enums" são String: role admin|consultant|manager|committee|biller|
//   emitter, type grain|input, kind grain|input, status sentToManager|pending|
//   approved|denied|invoiced|cprIssued|cprSigned|cprRegistered,
//   ruleType none|percentOfTotal|valuePerHa. São String de propósito, e não
//   `enum` do Postgres — a validação mora nos DTOs (`@IsIn`) e um valor novo
//   não pede migration nem deploy coordenado entre banco e aplicação.
// - Permuta é registro HISTÓRICO: nomes/preços ficam desnormalizados
//   (snapshots) e os FKs usam SetNull para o histórico sobreviver a exclusões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Usuário que loga no app: admin (administra o sistema), gerente, comitê,
/// faturista e emissor (os quatro postos da retaguarda) ou consultant (registra
/// permutas para a própria carteira e preenche a cédula). Produtor NÃO é
/// usuário.
model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("consultant")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// UNIDADE a que esta pessoa pertence (a lotação dela).
  ///
  /// Era `branch`, texto livre digitado no cadastro. Enquanto foi texto, "Filial
  /// 02", "filial 02" e "F02" eram três filiais para qualquer agrupamento, e não
  /// havia como perguntar "quem responde por esta unidade?" — que é justamente a
  /// pergunta do fluxo do gerente.
  unitId Int?
  unit   Unit? @relation("UserUnit", fields: [unitId], references: [id], onDelete: SetNull)

  /// O NOME da unidade no momento em que ele foi gravado.
  ///
  /// Continua existindo — e continua se chamando `branch` — porque é o rótulo
  /// que a permuta congela (`Barter.consultantBranch`), o que os rankings do
  /// painel agrupam e o que as permutas anteriores ao cadastro de unidades
  /// guardam. É snapshot pelo mesmo motivo de `Season.grainName`: excluir a
  /// unidade não pode apagar a memória de onde a pessoa estava. Quem escreve é
  /// um lugar só (user-provisioning.service.ts), a partir de `unit`.
  branch String?

  /// O GERENTE desta pessoa. Só o consultor tem, e para ele é obrigatório no
  /// cadastro (ver ConsultantDto): é a ele que as permutas do consultor são
  /// enviadas, e é ele quem escreve o parecer técnico delas.
  ///
  /// O vínculo é com a PESSOA, não com o lugar. A unidade de retirada é
  /// logística e não tem relação nenhuma com isto: uma permuta retirada na
  /// Filial 34 continua sendo analisada pelo gerente do consultor que a
  /// registrou.
  ///
  /// Nulável no banco porque os outros papéis não têm gerente — e porque a
  /// exclusão de um gerente precisa deixar os consultores dele órfãos em vez de
  /// apagá-los. Um consultor sem gerente não registra permuta até o admin
  /// designar outro.
  managerId Int?
  manager   User? @relation("ConsultantManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Senha provisória: o consultor recém-provisionado pelo admin precisa
  /// trocá-la antes de usar o app. O seed de demonstração nasce com false
  /// para o acesso rápido continuar direto.
  mustChangePassword Boolean @default(false)

  /// Tentativas de senha erradas SEGUIDAS. Zera no acerto; ao chegar no teto,
  /// a conta descansa (ver lockedUntil e MAX_FAILED_ATTEMPTS em auth.service).
  failedLoginAttempts Int @default(0)

  /// Até quando esta conta recusa tentativa de senha, mesmo a correta.
  ///
  /// O limite por IP sozinho não protege UMA conta: dez tentativas por minuto
  /// por IP viram muitas por minuto vindas de muitos IPs, e a conta do admin é
  /// alvo conhecido. Este campo é a trava do outro lado — por conta, não por
  /// origem.
  lockedUntil DateTime?

  tokens AccessToken[]

  /// A CARTEIRA desta pessoa — os produtores que ela atende. Cada produtor está
  /// na carteira de um consultor só (ver `Producer.consultantId`).
  wallet Producer[]

  barters Barter[] @relation("ConsultantBarters")

  /// Os consultores sob a gerência desta pessoa (só gerente tem). É por aqui
  /// que a permuta chega até ele: ela é endereçada ao gerente de quem a
  /// registrou.
  team User[] @relation("ConsultantManager")

  /// As permutas endereçadas a este gerente, esperando ou já com parecer.
  opinions Barter[] @relation("ManagerOpinions")

  /// Os AVISOS desta pessoa — ver `Notice`.
  notices Notice[]

  @@index([managerId])
}

/// Token de acesso opaco (guardamos só o SHA-256; o valor cru vai ao cliente).
/// Logout apaga a linha — revogação real no servidor.
model AccessToken {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Validade da sessão. O app guarda o token no aparelho entre aberturas,
  /// então ele precisa morrer sozinho: um token roubado vale no máximo até
  /// aqui, mesmo que ninguém faça logout. Ver TOKEN_TTL_DAYS.
  expiresAt DateTime

  /// Última vez que este token foi USADO — a segunda morte da sessão.
  ///
  /// O prazo absoluto acima resolve "esta sessão é velha demais"; ele não
  /// resolve o aparelho que sumiu do bolso na semana passada e cujo token ainda
  /// tem três semanas de vida. A inatividade resolve: sessão parada há
  /// TOKEN_IDLE_DAYS morre, e quem usa o app todo dia não é incomodado.
  ///
  /// A escrita é represada (ver TOUCH_INTERVAL_MS no AuthGuard): sem isso, toda
  /// requisição autenticada da API viraria também um UPDATE.
  lastUsedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([lastUsedAt])
}

/// UNIDADE: o lugar físico onde o produtor RETIRA os insumos da permuta.
///
/// É um LOCAL, e só. Ela não tem dono, não decide fluxo e não escolhe quem
/// analisa a permuta — quem dá o parecer é o gerente do CONSULTOR (ver
/// `User.managerId`), independentemente de onde a retirada acontece. O
/// consultor escolhe qualquer unidade da lista, inclusive uma de outra praça,
/// porque a retirada é decisão de logística combinada com o produtor.
///
/// Vale registrar por que ela existe como cadastro e não como texto: a filial
/// era digitada à mão, e "Filial 02", "filial 02" e "F02" eram três lugares
/// para qualquer agrupamento ou relatório.
model Unit {
  id   Int    @id @default(autoincrement())
  name String

  /// O mesmo nome reduzido à forma canônica (sem acento, sem caixa, sem espaço
  /// repetido). É ELE que carrega a unicidade, pelo mesmo motivo de
  /// `Producer.documentDigits`: sobre o texto cru, "Filial 02" e "FILIAL 02"
  /// passariam como duas unidades, e a mesma praça apareceria duas vezes na
  /// lista de retirada.
  nameKey String @unique

  /// Município/UF, como no produtor — é o que distingue duas unidades de nome
  /// parecido na hora de escolher onde retirar.
  city String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   User[]   @relation("UserUnit")
  barters Barter[]

  /// As cédulas que nomeiam esta unidade como LOCAL DA ENTREGA do grão.
  cprDeliveries BarterCpr[] @relation("CprDeliveryUnit")
}

/// Produtor (cliente) designado nas permutas; está na CARTEIRA de um consultor
/// (ver `consultantId`). Fica sem nenhum — aguardando realocação — quando esse
/// consultor é excluído.
model Producer {
  id             Int     @id @default(autoincrement())
  name           String
  /// CPF/CNPJ como o admin digitou — é o que aparece na tela e no comprovante.
  document       String
  /// O mesmo documento reduzido a dígitos. É ELE que carrega a unicidade:
  /// comparar o texto cru deixaria "CPF 123.456.789-00" e "12345678900"
  /// passarem como produtores diferentes, que é exatamente o cadastro em
  /// duplicidade que a regra existe para impedir.
  documentDigits String  @unique
  phone          String?
  farmName       String
  city           String

  // A ÁREA NÃO MORA MAIS AQUI. Ela era a "área cultivável" do produtor, um
  // número só para a fazenda inteira — e a fazenda não planta uma coisa só: dos
  // 120 ha, 60 vão de soja e 60 de trigo. Lida daqui, ela cobrava o seguro da
  // fazenda inteira numa permuta de trigo e media os mínimos por hectare contra
  // terra que não era daquela cultura. Quem diz a área agora é a PERMUTA (ver
  // `Barter.plantedAreaHa`): quantos hectares DAQUELA cultura ela cobre.

  /// COMO ESTE PRODUTOR RECOLHE o Funrural: `comercializacao` (sobre a receita
  /// da venda) ou `folha` (sobre a folha de pagamento — e aí sobre a entrega
  /// fica só o Senar). Ver `src/barters/tax-regime.ts`.
  ///
  /// Mora no CADASTRO, e não na permuta, porque é o que ele é: a opção formal
  /// que o produtor fez (ou não fez) perante o fisco vale para o ano inteiro e
  /// para todas as entregas dele. Enquanto a pergunta era feita permuta a
  /// permuta, o consultor respondia de memória a cada fechamento — e a segunda
  /// permuta do mesmo produtor saía num regime diferente da primeira sem
  /// ninguém ter mudado nada no mundo real.
  ///
  /// A permuta continua GRAVANDO o regime e a alíquota que aplicou
  /// (`Barter.taxRegime`/`taxRate`): daqui sai o valor do dia, e o que já foi
  /// fechado não se reescreve quando o produtor faz a opção no ano seguinte.
  ///
  /// O padrão é `comercializacao` — é o regime de quem não fez opção nenhuma,
  /// e é o que os cadastros anteriores a este campo têm de verdade.
  taxRegime String @default("comercializacao")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O consultor que atende este produtor — a CARTEIRA, uma só. Quem a define é
  /// o admin (ver CAPABILITY.producersManage).
  ///
  /// Já foi lista (`ProducerConsultant`, consultores dividindo o cliente) e
  /// voltou a ser coluna: a regra é um consultor por produtor, e é a coluna que
  /// a garante — com a tabela de vínculos, "um só" dependeria de toda gravação
  /// lembrar de apagar o vínculo anterior.
  ///
  /// Nulo quando o consultor é excluído (SetNull): o produtor não some junto, e
  /// espera o admin realocá-lo. As permutas dele não dependem disto — cada uma
  /// guarda quem a registrou (`Barter.consultantId`).
  consultantId Int?
  consultant   User? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  barters Barter[]

  // A pergunta da listagem do consultor: "quais produtores são meus?".
  @@index([consultantId])
}

/// O SEGURO AGRÍCOLA por MUNICÍPIO — quanto custa segurar um hectare em cada
/// praça onde a empresa permuta.
///
/// O seguro é uma proteção de preço de praça, não de cliente: o que o define é
/// o RISCO DO LUGAR — o regime de chuva, o histórico de granizo, a seca que
/// volta a cada três anos naquela região. Por isso a base é por município, e não
/// por produtor: dois vizinhos da mesma linha pagam o mesmo por hectare, e é
/// exatamente isso que a seguradora cota.
///
/// A CONTA é a mais simples do sistema, e é a leitura literal da regra:
///
///     custo do seguro = área plantada da permuta × valor por hectare
///
/// Ele NÃO é produto de catálogo, e essa distinção é deliberada. O catálogo é a
/// lista do FORNECEDOR de insumos, carregada da planilha dele e precificada por
/// versão do Barter (ver `VersionPrice`); o seguro é contratado de uma
/// seguradora, cotado por região e não tem unidade de venda nem embalagem. Posto
/// no catálogo, ele apareceria no relatório de preço do produto, na carga
/// seguinte e no seletor de insumos do consultor. Se a permuta leva seguro é a
/// política da versão (ver `BarterVersion.insurancePolicy`) — e, quando ela é
/// opcional, a escolha do consultor com o produtor.
///
/// A CHAVE é o município NORMALIZADO, pelo mesmo motivo de `Unit.nameKey` e de
/// `Producer.documentDigits`: sobre o texto cru, "Campo Mourão/PR", "campo
/// mourao/pr" e "Campo Mourao / PR" seriam três praças com três preços, e a
/// permuta encontraria uma delas por acaso de digitação. O cadastro do produtor
/// escreve o município como "Maringá/PR", e é essa forma que se compara.
model InsuranceRate {
  id Int @id @default(autoincrement())

  /// O município como o admin o escreveu — é o que a tela mostra e o que sai na
  /// linha do seguro dentro da permuta ("Seguro agrícola — Maringá/PR").
  city String

  /// O mesmo município reduzido à forma canônica. É ELE que carrega a unicidade
  /// e é por ele que a permuta acha a taxa do produtor.
  cityKey String @unique

  /// Quanto custa segurar UM HECTARE nesta praça (R$/ha).
  ///
  /// Maior que zero sempre: uma taxa zerada não é "seguro de graça", é linha
  /// pela metade — e ela produziria uma permuta com seguro contratado cujo custo
  /// não existe. Quem recusa o zero é o DTO, e não o banco, pelo mesmo motivo de
  /// sempre: a frase que o admin lê é do domínio.
  valuePerHa Float

  /// O que o admin tem a dizer sobre esta linha (a seguradora, a vigência da
  /// cotação, a cultura a que ela se refere). Opcional — a maioria não tem.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CLASSE do insumo — a taxonomia com que o FORNECEDOR organiza a lista de
/// preços (herbicidas, inseticidas, fungicidas, fertilizantes, fertilizantes
/// foliares, óleos e adjuvantes, inoculantes…).
///
/// A lista nasce do arquivo: a carga em massa cria a classe que ainda não
/// existe, e é assim que ela acompanha o fornecedor sem depender de migration.
/// O que NÃO existe é criar, renomear ou excluir classe pelo app — quem define
/// a taxonomia é a lista de preços, não quem cadastra.
///
/// O casamento é por nome normalizado (sem acento, sem caixa, sem espaço
/// repetido) ou pelo slug: é isso que impede "Defensivo", "DEFENSIVOS" e
/// "Defensivos Foliares" de virarem três classes medindo mínimos diferentes.
///
/// A REGRA de mínimo (percentOfTotal >= ruleValue % do custo, ou valuePerHa
/// >= R$ × área) é decisão comercial do admin e muda de safra para safra.
model ProductClass {
  id Int @id @default(autoincrement())

  /// Identificador estável da classe (`fungicidas`, `seguro-agricola`…). É por
  /// ele que a planilha e o código se referem a ela: o nome de exibição pode
  /// ser reescrito um dia, o slug não.
  slug String @unique
  name String

  /// Ordem de exibição — a lista tem um jeito certo de ser lida (do defensivo
  /// ao serviço), e ordenar por id ou por nome desmancharia isso.
  position Int @default(0)

  ruleType  String @default("none")
  ruleValue Float  @default(0)

  products Product[]
}

/// type=input: insumo retirado (forma o custo). type=grain: grão de pagamento.
///
/// O CADASTRO do produto mora aqui (nome, unidade, categoria, exigência por
/// hectare); o VALOR de troca não mora mais: ele pertence à versão do Barter
/// (ver VersionPrice e BarterVersion.grainPrice). `currentPrice` continua como
/// o último valor publicado — é o que alimenta o relatório de preço do produto
/// e a linha do tempo — mas quem precifica uma permuta é a versão vigente.
model Product {
  id            Int           @id @default(autoincrement())
  name          String
  unit          String
  type          String
  currentPrice  Float
  requiredPerHa Float         @default(0)
  classId       Int?
  productClass  ProductClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  /// Código do produto na planilha do fornecedor. É a chave de casamento da
  /// carga em massa: sem ele, "Ureia 45%" e "UREIA 45 %" viram dois cadastros a
  /// cada arquivo importado.
  sku String? @unique

  /// A UNIDADE deste item entrou como palpite e precisa de revisão.
  ///
  /// A lista de preços não tem coluna de unidade: a embalagem vem no fim da
  /// descrição (`emb.20 l`, `BIG-BAG`) e, quando ela não vem, no padrão da
  /// classe. Sobrando o que nem assim se resolve, o item entra com "unidade" e
  /// esta marca — que é o que permite achá-lo depois, em vez de a unidade
  /// errada aparecer no comprovante do produtor sem ninguém saber de onde veio.
  ///
  /// Some quando o admin escreve a unidade (ou quando uma carga seguinte
  /// consegue lê-la).
  unitPending Boolean @default(false)

  /// O MODELO DA CPR deste grão — o padrão com que ele é recebido (cláusula V,
  /// "c") e o peso da saca que converte sacas em quilos (cláusula III). Só
  /// produtos `type: "grain"` o usam.
  ///
  /// É o PONTO DE PARTIDA da cédula, e não a regra: a CPR nova nasce com estes
  /// números (ver `suggestFrom`), e a cédula continua guardando os dela
  /// (`BarterCpr.sackWeightKg` e companhia) — o padrão muda de um ano para o
  /// outro, e mudar o modelo não pode reescrever cédula já preenchida.
  ///
  /// Zero nos percentuais é "não definido", como na cédula: a CPR nasce com o
  /// campo vazio e `cprGaps()` cobra o número de quem preenche.
  cprSackWeightKg  Float @default(60)
  cprMaxMoisture   Float @default(0)
  cprMaxImpurities Float @default(0)
  cprOilContent    Float @default(0)

  priceHistory  PriceHistoryEntry[]
  items         BarterItem[]
  versionPrices VersionPrice[]

  /// As SAFRAS deste grão (só produtos `type: "grain"` têm): Soja 25/26, Soja
  /// 26/27… Ver `Season`.
  seasons Season[] @relation("SeasonGrain")
}

/// A SAFRA DA CULTURA — "Soja 26/27", "Canola 2027". É o ciclo de UM grão, e é
/// nela que o Barter daquela cultura acontece.
///
/// A safra já foi o ciclo do programa inteiro (B2026, com as culturas convivendo
/// numa versão só), e voltou a ser de uma cultura porque o calendário é da
/// cultura: a soja cruza o ano (planta em setembro, colhe em março), a canola é
/// de inverno e cabe num ano só, e cada uma abre, bate meta e encerra no seu
/// tempo. Com uma safra só para todas, encerrar a canola encerrava a soja junto.
///
/// O ANO é o que o admin digita ao abrir — `startYear` e `endYear`, iguais na
/// cultura anual. É ele que dá o rótulo ("Soja 26/27", "Canola 2027") e o código.
///
/// O CÓDIGO tem duas formas, pelo mesmo motivo: `code` é o que as pessoas leem
/// (`SOJA26/27`), e a barra dele não cabe numa URL; `slug` é a mesma coisa sem
/// ela (`SOJA2627`), e é por ele que as rotas endereçam a safra.
///
/// No máximo UMA SAFRA ABERTA POR GRÃO — quem confere é a abertura e a
/// reabertura (ver `SeasonsService`). Duas safras de soja abertas ao mesmo tempo
/// trariam de volta a pergunta "em qual delas esta permuta caiu?".
///
/// Encerrar a safra é o fim do ciclo daquela cultura: nenhuma versão nova sai
/// nela, e a vigente fecha junto. As outras culturas não sentem nada.
model Season {
  id   Int    @id @default(autoincrement())
  code String @unique
  slug String @unique
  name String

  /// O GRÃO da safra — desnormalizado (nome e unidade) pelo motivo de sempre:
  /// excluir o produto do catálogo não pode apagar a memória de que esta safra
  /// era de soja.
  grainId   Int?
  grain     Product? @relation("SeasonGrain", fields: [grainId], references: [id], onDelete: SetNull)
  grainName String
  grainUnit String

  startYear Int
  endYear   Int

  status     String    @default("open")
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  closedBy   String?
  closedById Int?

  /// O SEGURO PADRÃO desta cultura — `required`, `optional` ou `none`.
  ///
  /// É uma INDICAÇÃO, e não a regra: quem vale é a política de cada versão (ver
  /// `BarterVersion.insurancePolicy`). Esta é a que vem preenchida quando o admin
  /// publica a próxima, porque a cultura costuma ser de um jeito ("a soja leva
  /// seguro") e só às vezes muda numa versão.
  insurancePolicy String @default("none")

  versions BarterVersion[]
  barters  Barter[]

  // "Qual safra deste grão está aberta?" — a pergunta da abertura e do registro.
  @@index([grainId, status])
}

/// O BARTER LANÇADO — uma versão da safra de UMA cultura (SOJA26/27.01, .02…).
///
/// É ela que responde "com que valores se permuta esta cultura hoje": a tabela
/// de insumos (que é DESTA cultura — cada uma sobe a sua planilha), a cotação da
/// saca, a produtividade estimada e o vencimento da CPR. Uma correção de valores
/// no meio da safra não reescreve a versão vigente — publica a próxima, e a
/// anterior fecha. É isso que mantém legível o que foi acordado em cada momento.
///
/// UMA VIGENTE POR SAFRA, e por isso várias ao mesmo tempo no sistema: a soja na
/// versão 02 e a canola na 01, cada uma com a sua meta e o seu encerramento.
///
/// A VIGÊNCIA tem duas naturezas de propósito: `endsAt` é uma data que o admin
/// marcou e por isso TRAVA (a API recusa permuta depois dela); as metas abaixo
/// medem, e o que elas fazem ao serem batidas é ESCOLHA da versão —
/// `closeOnGoal`. Ver isOpenAt() em version-progress.ts.
///
/// O CÓDIGO tem as mesmas duas formas da safra: `code` para ler
/// (`SOJA26/27.01`), `slug` para a URL (`SOJA2627.01`).
model BarterVersion {
  id       Int    @id @default(autoincrement())
  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number   Int
  code     String @unique
  slug     String @unique
  status   String @default("active")

  /// Valor (R$) da saca da cultura nesta versão — a taxa que converte o custo
  /// dos insumos em sacas. Digitado pelo admin ao publicar; a planilha é de
  /// insumo.
  grainPrice Float

  /// A PRODUTIVIDADE ESTIMADA (sc/ha) — a taxa que converte as sacas da permuta
  /// em HECTARES a penhorar. É a outra metade da conversão que `grainPrice`
  /// começa.
  ///
  /// OBRIGATÓRIA na publicação. Enquanto ela for 0, `POST /barters` recusa: sem
  /// produtividade não há área exigida, e uma permuta que passasse sem ela
  /// entraria na esteira sem garantia dimensionada.
  estimatedYield Float @default(0)

  /// O VENCIMENTO DA CPR das permutas desta versão — a data em que a entrega do
  /// grão vence.
  ///
  /// Não é dado da cédula: todas as cédulas da mesma versão vencem no mesmo dia,
  /// e enquanto foi campo do formulário cada faturista digitava o seu. É da
  /// VERSÃO, e não da safra, porque uma versão lançada mais tarde pode vencer
  /// mais tarde.
  ///
  /// Nulável porque o lançamento pode acontecer antes de a data estar acertada —
  /// e aí `cprGaps()` cobra, com o recado endereçado ao admin. É o único campo
  /// que se acerta também numa versão ENCERRADA: ele vale para as cédulas que
  /// ainda não saíram.
  cprDueDate DateTime?

  /// A POLÍTICA DE SEGURO desta versão: `required` (toda permuta leva),
  /// `optional` (o consultor escolhe com o produtor) ou `none`.
  ///
  /// Nasce preenchida com a da safra (`Season.insurancePolicy`) e o admin pode
  /// mudá-la ao publicar e na versão vigente. Mudá-la vale para as permutas
  /// NOVAS: as registradas têm a escolha e a taxa congeladas
  /// (`Barter.insuranceChoice`, `insuranceRatePerHa`).
  ///
  /// Com seguro, a linha é precificada pelo MUNICÍPIO DO PRODUTOR (ver
  /// `InsuranceRate`) sobre a área plantada da permuta, e entra na conta como
  /// qualquer custo adiantado. Município sem taxa RECUSA o registro quando o
  /// seguro é obrigatório, e bloqueia a opção quando ele é opcional.
  insurancePolicy String @default("none")

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Metas de encerramento (null = sem meta). Medem o realizado das permutas
  /// APROVADAS desta versão; ao atingir, o painel avisa e `closeOnGoal` diz se o
  /// Barter da cultura fecha junto. Fechada, o admin pode publicar a próxima
  /// versão com outra meta — o realizado recomeça nela.
  ///
  /// Não há meta de lucro: sem custo na lista de preços, ela seria a de vendas
  /// com outro nome.
  targetSales   Float?
  targetSacks   Float?
  targetBarters Int?

  /// O QUE FAZER quando a meta bater: encerrar a versão (true) ou só avisar e
  /// esperar o admin encerrar (false, o padrão).
  ///
  /// Ligado, o fechamento acontece no instante da APROVAÇÃO que cruzou a meta —
  /// não há relógio nem rotina de madrugada. É o único momento em que o
  /// realizado cresce (ver COUNTS_AS_REALIZED em version-progress.ts), então o
  /// ato humano que bateu a meta é também o que fecha a versão, e a trilha
  /// aponta para ele.
  ///
  /// Só faz sentido com pelo menos uma meta definida, e o service recusa a
  /// combinação vazia.
  closeOnGoal Boolean @default(false)

  /// De onde a tabela veio (nome do arquivo) e a observação do lançamento.
  sourceFile String?
  note       String?

  closedAt   DateTime?
  closedBy   String?
  closedById Int?

  prices  VersionPrice[]
  barters Barter[]

  @@unique([seasonId, number])
}

/// Uma LINHA da tabela de valores da versão: o preço de um insumo naquele
/// lançamento.
///
/// Não há custo aqui: a lista de preços do fornecedor traz o preço de venda, e
/// só. O Barter mede VENDAS — margem exigiria um dado que a operação não tem, e
/// um custo zerado faria "lucro" e "faturamento" mostrarem o mesmo número com
/// nomes diferentes.
///
/// Nome e unidade são snapshot pelo mesmo motivo do BarterItem: a tabela
/// precisa continuar legível depois que o produto sair do catálogo.
model VersionPrice {
  id          Int           @id @default(autoincrement())
  versionId   Int
  version     BarterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unit        String
  price       Float

  @@unique([versionId, productId])
}

/// Linha do tempo dos reajustes. changedBy desnormalizado: o histórico
/// sobrevive à exclusão do usuário.
model PriceHistoryEntry {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Float
  changedBy   String
  changedById Int?
  changedAt   DateTime
}

/// Permuta: insumos retirados formam um custo, pago com o grão da safra, cujas
/// sacas são calculadas pelo servidor. `code` (PRM-AAAA-NNN) é o id público.
///
/// Toda permuta nasce DENTRO de uma versão do Barter — é ela que diz por quais
/// valores esta permuta foi fechada. `versionCode` fica desnormalizado porque é
/// o que aparece no detalhe e no comprovante: o documento precisa dizer em qual
/// gestão o acordo foi feito, mesmo que a versão seja removida do banco.
///
/// A CULTURA da permuta é UMA, fixa desde o registro: ela é a safra da versão em
/// que a permuta nasceu (`seasonId`, com o nome congelado em `seasonName`). Não
/// há troca de cultura — uma permuta de soja que vira de trigo é outra permuta,
/// com outra tabela de insumos. A linha do grão (`BarterItem` de `kind:
/// "grain"`) continua guardando o produto e a cotação congelados.
///
/// O CAMINHO dela é o `status`, e ele é uma LINHA DE PRODUÇÃO de cinco postos:
///
///     draft → sentToManager → pending → approved              → invoiced →
///  (consultor)  (gerente)    (comitê)   approvedWithConditions  (faturista)
///                              ↑  ↓  ↘ denied
///                    awaitingRequirements
///                         (consultor)
///
///     → cprIssued → cprSigned → cprRegistered
///        (emissor)   (emissor)    (emissor)
///
/// `draft` é onde ela nasce: o consultor a montou, e ela ainda é DELE — não está
/// na mesa de ninguém e nenhuma fila da retaguarda a enxerga. Escrito o parecer
/// do consultor, ele a encaminha ao GERENTE (`sentToManager`), que dá o parecer
/// técnico. Daí ela vai ao COMITÊ (`pending`), que lê o pedido e os dois
/// pareceres e decide — é a única instância que aprova, aprova com ressalva ou
/// nega. Antes de decidir, o comitê pode EXIGIR avalista, hipoteca e/ou seguro:
/// a permuta volta ao consultor (`awaitingRequirements`) e, cumpridas as
/// exigências, retorna DIRETO ao comitê, sem passar de novo pelo gerente — que
/// é só avisado (ver `Notice`). Aprovada (com ou sem ressalva), ela cai na fila do FATURISTA, que
/// fatura e anexa as notas (`invoiced`). Aí começa o trecho do EMISSOR: ele
/// confere a cédula que o consultor preencheu e a emite (`cprIssued`), colhe as
/// assinaturas (`cprSigned`) e a leva a registro (`cprRegistered`), que é o fim
/// da linha.
///
/// Quem guarda esse caminho — quem move o quê, de onde para onde, e o que
/// responder a quem chega fora de hora — é `src/barters/barter-workflow.ts`. O
/// schema só grava o estado; a máquina de estados é quem sabe que ele significa.
///
/// "Revisão" e não "análise" é a palavra do sistema para a etapa do comitê: a
/// rota é `POST /barters/:code/review` e os campos são `reviewedBy`/`reviewedAt`.
/// O gerente também analisa — chamar as duas coisas de análise deixava as etapas
/// indistinguíveis no vocabulário.
model Barter {
  id   Int    @id @default(autoincrement())
  code String @unique

  /// O NÚMERO DA CPR desta permuta — `CPR-<ano>-NNN`, sequencial dentro do ano
  /// e único, reservado no REGISTRO junto com `code` (ver `createWithCode`).
  ///
  /// Mora na PERMUTA, e não em `BarterCpr`, porque nasce antes da cédula: a
  /// permuta existe sem rascunho de CPR até o consultor começar a preenchê-la,
  /// e o número precisa existir desde o primeiro dia — é por ele que a cédula é
  /// citada na conversa com o produtor, no comprovante e na fila do emissor.
  ///
  /// Era texto livre, informado pelo EMISSOR no ato da emissão, pelo argumento
  /// de que a numeração vinha de fora do sistema. Na prática ele era digitado
  /// à mão, sem conferência de repetição, e a cédula passava semanas sem nome.
  /// Agora o sistema numera, e ninguém digita.
  ///
  /// SEQUÊNCIA PRÓPRIA, e não o número do `code` trocado de prefixo: as
  /// permutas anteriores a esta coluna herdaram o número que o emissor tinha
  /// informado, e as duas sequências já não andam juntas.
  cprNumber String @unique

  versionId        Int?
  version          BarterVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  versionCode      String         @default("")
  consultantId     Int?
  consultant       User?          @relation("ConsultantBarters", fields: [consultantId], references: [id], onDelete: SetNull)
  producerId       Int?
  producer         Producer?      @relation(fields: [producerId], references: [id], onDelete: SetNull)
  consultantName   String
  consultantBranch String         @default("")
  producerName     String

  /// UNIDADE DE RETIRADA — onde o produtor busca os insumos desta permuta.
  ///
  /// É LOGÍSTICA, e nada além disso: ela não escolhe quem analisa a permuta nem
  /// participa de nenhuma regra. O consultor pode mandar a retirada para
  /// qualquer unidade, inclusive uma de outra praça, e o parecer continua sendo
  /// do gerente dele. `unitName` é o snapshot para o detalhe e o comprovante,
  /// pelo mesmo motivo de `producerName`.
  unitId   Int?
  unit     Unit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitName String @default("")

  /// A SAFRA DA CULTURA desta permuta ("Soja 26/27") — a da versão em que ela
  /// nasceu, congelada no registro. O nome vai no comprovante e na CPR; o id é o
  /// que o filtro da listagem e o painel por cultura usam.
  ///
  /// Repete o que a versão já diz, e de propósito: a versão pode sumir do banco
  /// (SetNull), e a permuta precisa continuar dizendo de que safra ela é.
  seasonId   Int?
  season     Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonName String  @default("")

  /// A ÁREA PLANTADA (ha) DA CULTURA que esta permuta cobre — informada pelo
  /// consultor no registro.
  ///
  /// Ela era a área cultivável do CADASTRO do produtor, congelada aqui. Saiu de
  /// lá porque a fazenda planta mais de uma coisa: dos 120 ha, 60 de soja e 60 de
  /// trigo. É ela a régua de tudo o que é "por hectare" na permuta: o seguro
  /// (área × R$/ha), os mínimos por hectare, o investimento (sc/ha) e o TETO do
  /// penhor — a garantia exigida não pode passar da lavoura que existe.
  ///
  /// Nas permutas anteriores a ela, é a área do cadastro que estava congelada — o
  /// número com que elas foram calculadas e aprovadas. 0 nas anteriores a esse
  /// congelamento: sem área não há sc/ha, e a leitura devolve `null`.
  plantedAreaHa Float @default(0)

  /// O PENHOR desta permuta — as duas taxas com que a área de garantia foi
  /// dimensionada, congeladas no registro.
  ///
  /// `pledgeYield` é a produtividade estimada (sc/ha) da versão em que ela nasceu
  /// e `pledgeMarginPercent` é a margem de segurança da credora naquele dia.
  /// Juntas com as sacas do item de grão, elas produzem a área exigida:
  ///
  ///     área exigida = (sacas ÷ pledgeYield) × (1 + pledgeMarginPercent / 100)
  ///
  /// SÃO SNAPSHOT pelo mesmo motivo de `taxRate` e `plantedAreaHa`: as duas
  /// mudam (a versão seguinte revê a produtividade, a diretoria revê a margem), e
  /// lidas na hora de conferir fariam uma permuta já encaminhada passar a exigir
  /// mais área do que as lavouras que alguém já anotou — sem que nada nela
  /// tivesse mudado.
  ///
  /// A ÁREA EXIGIDA NÃO É COLUNA, e isso é deliberado: ela é derivada, como os
  /// quilos e o valor total da cédula. As SACAS mudam depois do registro — deferir
  /// um produto de fora do Barter recalcula a linha do grão (ver `repriceGrain`)
  /// —, e uma área exigida gravada continuaria dizendo o número da semana
  /// passada num campo que parece atual.
  ///
  /// `pledgeYield` 0 é a MARCA DAS PERMUTAS ANTERIORES À REGRA, e é o que as
  /// isenta: a partir deste campo, `POST /barters` recusa versão sem
  /// produtividade, então toda permuta nova nasce com ela preenchida. Zero não é
  /// "sem produtividade", é "nasceu antes de o penhor ser dimensionado" — e
  /// cobrar área dessas travaria a emissão de títulos já aprovados por causa de
  /// uma regra que não existia quando eles foram fechados.
  pledgeYield         Float @default(0)
  pledgeMarginPercent Float @default(0)

  /// O SEGURO AGRÍCOLA desta permuta — o município que o precificou e a taxa
  /// (R$/ha) com que ele foi cotado, congelados no registro.
  ///
  /// SÃO SNAPSHOT pelo mesmo motivo de `taxRate`, `plantedAreaHa` e das duas
  /// taxas do penhor: a base por município é cadastro vivo (o admin recota a
  /// praça quando a seguradora recota), e o produtor muda de município quando
  /// arrenda do outro lado do rio. Lidas na hora de mostrar, uma permuta já
  /// encaminhada passaria a custar mais sacas do que as que o consultor
  /// combinou com o produtor — sem que nada nela tivesse mudado.
  ///
  /// O CUSTO NÃO É COLUNA, e isso é deliberado: ele é derivado, como a área do
  /// penhor e os quilos da cédula. Ele vive na LINHA do seguro
  /// (`BarterItem.insurance`), que é onde o custo da permuta mora inteiro — e
  /// tê-lo também aqui criaria dois lugares dizendo o mesmo número, que é a
  /// primeira condição para eles divergirem.
  ///
  /// `insuranceRatePerHa` 0 é "esta permuta não tem seguro". POR QUE não tem é
  /// `insuranceChoice`.
  insuranceCity      String @default("")
  insuranceRatePerHa Float  @default(0)

  /// COMO o seguro chegou (ou não) a esta permuta: `required` (a versão
  /// obrigava), `accepted` (era opcional e o produtor quis), `declined` (era
  /// opcional e o produtor recusou) ou `none` (a versão não oferecia).
  ///
  /// Existe por causa do seguro opcional: "sem seguro" passou a ter duas
  /// histórias, e elas pesam diferente na mesa do comitê — o produtor que
  /// RECUSOU a apólice é uma informação de risco; a versão que não oferecia, não.
  insuranceChoice String @default("none")

  status String @default("draft")

  /// O PARECER DO CONSULTOR e o momento em que ele encaminhou a permuta.
  ///
  /// É a peça que faltava no começo da linha. O consultor é quem conhece o
  /// cliente — safras anteriores, pontualidade, o que está plantado —, e nada
  /// disso chegava escrito: a permuta ia ao gerente como uma lista de insumos, e
  /// o que o consultor sabia ficava no telefonema que ele dava depois.
  ///
  /// Ele é gravado no ENCAMINHAMENTO, mas pode ser escrito antes: enquanto a
  /// permuta é `draft`, o consultor salva o texto quantas vezes quiser (ver
  /// `PUT /barters/:code/note`). É o único texto do fluxo que se reescreve — os
  /// outros são assinaturas de etapas cumpridas. O que não se reescreve, aqui
  /// como nos outros, é o EVENTO: `consultantSentAt` marca o encaminhamento, e
  /// o texto que foi junto fica congelado no BarterEvent.
  ///
  /// Null nas permutas anteriores a este campo — elas nasceram já na mesa do
  /// gerente, e inventar um parecer para elas seria assinar em nome de alguém.
  consultantNote   String?
  consultantSentAt DateTime?

  /// O IMPOSTO DA ENTREGA — a entrega de grão é comercialização de produção
  /// rural, e sobre ela incidem o Funrural e o Senar.
  ///
  /// `taxRegime` é a FORMA escolhida no fechamento desta permuta:
  /// `comercializacao` (sobre a receita da venda) ou `folha` (sobre a folha de
  /// pagamento — e aí sobre a entrega fica só o Senar). Ver
  /// `src/barters/tax-regime.ts`.
  ///
  /// `taxRate` é a alíquota (%) que essa escolha produziu, e é SNAPSHOT pelo
  /// mesmo motivo de `producerName` e do preço do item: a alíquota muda por lei
  /// (a atual vale desde 1º/04/2026) e o que decide qual vale é a data da
  /// comercialização. Recalculando na leitura, um comprovante emitido depois da
  /// lei seguinte passaria a mostrar um imposto diferente do que foi acordado.
  ///
  /// `taxRate` 0 nas permutas anteriores a estes campos: elas não têm alíquota
  /// registrada, e inventar uma seria afirmar um número que ninguém aplicou.
  taxRegime String @default("comercializacao")
  taxRate   Float  @default(0)

  /// O GERENTE A QUEM ESTA PERMUTA FOI ENVIADA — o gerente do consultor no
  /// momento do registro — e o parecer técnico dele sobre a negociação.
  ///
  /// O destinatário é gravado no ENVIO, não lido do vínculo atual. É a leitura
  /// literal de "o consultor envia para o gerente": trocar o gerente de um
  /// consultor vale para as próximas permutas, e as que já estão na mesa de
  /// alguém continuam lá. O contrário faria uma permuta mudar de mãos sem
  /// ninguém ter agido sobre ela.
  ///
  /// O parecer é texto, e só texto: ele não aprova nem nega — quem decide é a
  /// instância seguinte, que o lê antes. Escrevê-lo é o que move a permuta de
  /// `sentToManager` para `pending`.
  ///
  /// `managerName` é snapshot (o parecer precisa continuar assinado depois que
  /// a conta for excluída); `managerId` fica como pista, com SetNull.
  managerId         Int?
  manager           User?     @relation("ManagerOpinions", fields: [managerId], references: [id], onDelete: SetNull)
  managerName       String?
  managerNote       String?
  managerReviewedAt DateTime?

  /// A DECISÃO DO COMITÊ: quem decidiu, quando, e a observação que acompanha.
  ///
  /// `reviewNote` se chamava `adminNote`, e o nome saiu junto com o poder: o
  /// admin não decide mais permuta (ver CAPABILITY.bartersReview). Um campo
  /// chamado "admin" guardando o texto do comitê seria uma pista falsa exatamente
  /// no registro que alguém vai ler para entender por que a permuta foi negada.
  ///
  /// `reviewedBy` é snapshot pelo mesmo motivo de `managerName` — a decisão
  /// continua assinada depois que a conta for excluída.
  ///
  /// `reviewNote` é OPCIONAL no schema e OBRIGATÓRIO em duas das três saídas: a
  /// negativa e a aprovação com ressalva não existem sem texto (ver
  /// `ReviewBarterDto`). Quem valida isso é a entrada, e não o banco, porque a
  /// obrigatoriedade depende do DESFECHO — uma coluna `NOT NULL` recusaria
  /// também a aprovação limpa, que não tem o que explicar, e reescreveria as
  /// decisões já gravadas sem observação.
  reviewNote   String?
  reviewedBy   String?
  reviewedById Int?
  reviewedAt   DateTime?

  /// AS EXIGÊNCIAS DO COMITÊ: avalista e hipoteca (`requiresCollateral`).
  ///
  /// HOJE ELAS SÃO UMA ETAPA. O comitê as marca ANTES de decidir, e marcar
  /// devolve a permuta ao consultor (`awaitingRequirements`). Cada uma liga, na
  /// cédula, um campo que até então nem aparece no formulário dele — os
  /// avalistas, os bens em hipoteca — e que passa a ser pendência que trava a
  /// volta ao comitê e a emissão (ver `cprGapsOf`). Elas se ACUMULAM: o comitê
  /// que recebe o avalista e pede também a hipoteca soma, não substitui. A
  /// decisão não as apaga; a negativa, sim.
  ///
  /// O SEGURO JÁ FOI A TERCEIRA, e saiu (ver a migration
  /// `seguradora_na_esteira`): exigi-lo fazia o consultor digitar o número de
  /// uma apólice na cédula, e a apólice passou a ser da SEGURADORA. O seguro de
  /// uma permuta é o da versão (`insuranceChoice`), e é ele que a manda à mesa da
  /// seguradora depois da aprovação.
  ///
  /// `requiresCollateral` se chamava "garantia real" na tela; o que o comitê
  /// pede e o consultor traz é a hipoteca, e o rótulo mudou. A coluna ficou.
  ///
  /// O que segue é a história de por que elas saíram do texto:
  ///
  /// Quem as define é o comitê, e elas viviam DENTRO de `reviewNote` — num
  /// parágrafo em português, escrito de um jeito diferente a cada reunião
  /// ("exigir aval do cônjuge", "com avalista", "condicionada a aval"). Isso
  /// bastava para quem lia a permuta e não bastava para mais nada: não havia
  /// como listar o que estava pendente de aval, o emissor descobria a exigência
  /// lendo prosa na véspera de emitir o título, e a que fosse esquecida no meio
  /// do texto não era esquecida por ninguém em particular.
  ///
  /// São CAMPOS SEPARADOS, e não um tipo de ressalva: elas se acumulam. A mesma
  /// decisão pede avalista E garantia real com frequência, e um campo único
  /// obrigaria a eleger a principal — que é uma pergunta que o comitê não faz.
  ///
  /// O TEXTO CONTINUA OBRIGATÓRIO na ressalva, e não foi substituído por elas:
  /// as caixas dizem O QUÊ, e só o texto diz QUAL — qual matrícula, quem se
  /// espera como avalista. Uma ressalva que fosse só booleanos mandaria o
  /// consultor de volta ao telefone, que é de onde este campo veio.
  ///
  /// `false` nas permutas anteriores a estes campos e em toda permuta de que o
  /// comitê não exigiu nada.
  requiresGuarantor  Boolean @default(false)
  requiresCollateral Boolean @default(false)

  /// A APÓLICE — o ato da SEGURADORA, só nas permutas com seguro.
  ///
  /// O NÚMERO mora aqui, e não mais na cédula, onde o consultor o digitava. Ele
  /// é o produto do posto que cria a apólice — como a nota é o do faturamento —,
  /// e a cédula o LÊ daqui (cláusula XVIII, "j"). Enquanto foi um campo do
  /// formulário do consultor, o título afirmava um seguro que ninguém tinha
  /// conferido contra documento nenhum, e só aparecia porque alguém lembrou de
  /// digitá-lo.
  ///
  /// O ARQUIVO é a apólice em si, e entra no MESMO ato do número: o número sem a
  /// apólice é afirmação sem prova; a apólice sem o número é um PDF que a cédula
  /// não tem como citar. `SetNull` pelo mesmo motivo do SCR — apagar o anexo não
  /// pode apagar a permuta.
  ///
  /// Os outros quatro campos são a ASSINATURA da etapa, como `invoicedBy` e
  /// `reviewedBy`: quem informou, quando e o que anotou. Null em toda permuta sem
  /// seguro — ela pula esta etapa — e nas aprovadas antes de ela existir.
  insurancePolicyNumber String?
  insurancePolicyFileId Int?        @unique
  insurancePolicyFile   BarterFile? @relation("BarterPolicy", fields: [insurancePolicyFileId], references: [id], onDelete: SetNull)
  insuredBy             String?
  insuredById           Int?
  insuredAt             DateTime?
  insuranceNote         String?

  /// O FATURAMENTO — o posto que mexe com dinheiro para fora.
  ///
  /// Os campos são os mesmos da decisão, de propósito: quem fez, quando, e o que
  /// anotou. O faturista não avalia e não devolve — ele só carimba o que o comitê
  /// aprovou —, então não há aqui nenhum campo de "resultado": ou a permuta foi
  /// faturada, e estas colunas dizem por quem, ou ela não foi.
  ///
  /// O QUE ELE PRODUZ são as notas, e elas são lista à parte (`invoices`): uma
  /// permuta sai em mais de um carregamento, e cada retirada gera a sua.
  invoicedBy   String?
  invoicedById Int?
  invoicedAt   DateTime?
  invoiceNote  String?

  /// A EMISSÃO DA CÉDULA — os três atos do emissor, cada um com a sua marca.
  ///
  /// Eles moram na PERMUTA, e não em `BarterCpr`, pelo mesmo motivo de
  /// `invoicedBy` e `reviewedBy` morarem aqui: são as assinaturas das ETAPAS, e
  /// etapa é da esteira. A cédula guarda o CONTEÚDO do documento (quem é o
  /// emitente, que lavoura é a garantia); a permuta guarda por onde ela andou.
  ///
  /// `cprEmittedBy` é snapshot em texto pelo mesmo motivo dos outros: a
  /// conferência continua assinada depois que a conta for excluída. E não há
  /// campo de "resultado" em nenhum dos três — a recusa da emissão não é um
  /// estado, é um 422 com a lista do que falta (ver `cprGaps`): o emissor não
  /// devolve a permuta, ele diz que o papel ainda não está pronto.
  cprEmittedBy    String?
  cprEmittedById  Int?
  cprEmittedAt    DateTime?
  cprEmissionNote String?

  /// A COLETA DE ASSINATURAS: quando ela se completou e o que houve nela (quem
  /// assinou, se faltou o cônjuge, se foi por assinatura eletrônica).
  cprSignedAt      DateTime?
  cprSignatureNote String?

  /// O REGISTRO do título — a data, onde ele foi registrado e sob que número.
  ///
  /// O PROTOCOLO é obrigatório no ato (ver `RegisterCprDto`), e é o que
  /// diferencia "levamos ao cartório" de "está registrado": sem número, não há
  /// como provar o registro nem como pedir a certidão depois.
  cprRegisteredAt   DateTime?
  cprRegistryNumber String?
  cprRegistryPlace  String?

  /// O PEDIDO DE ALTERAÇÃO — o único caminho de VOLTA da esteira, e ele tem
  /// dono nas duas pontas: pede o consultor que registrou, decide o admin.
  ///
  /// Ele existe porque a permuta erra depois de sair da mão de quem a montou:
  /// o produtor troca um insumo na véspera da retirada, a área muda, a
  /// quantidade saiu errada. Sem este caminho, as saídas eram pedir ao comitê
  /// que negasse (uma decisão de negócio usada como borracha, e que fica na
  /// história como negativa) ou registrar uma segunda permuta e deixar a
  /// primeira apodrecendo na fila de alguém.
  ///
  /// `changeRequestStatus` é o que existe de estado próprio: `open` (pedido na
  /// mesa do admin) ou `denied` (recusado, e o texto da recusa fica visível ao
  /// consultor). ACEITO não é um valor: o aceite devolve a permuta a `draft`, e
  /// é o `status` dela que passa a contar a história — um pedido "aceito"
  /// pendurado numa permuta que voltou a ser rascunho seria um segundo lugar
  /// dizendo a mesma coisa, e os dois poderiam divergir.
  ///
  /// `changeRequestFrom` é de onde ela veio, e é o que a RECUSA restaura: o
  /// pedido não tira a permuta da fila em que está (o gerente que ia dar o
  /// parecer continua podendo dar), então recusar precisa devolvê-la
  /// exatamente ao estado que ela tinha — e não a um estado deduzido.
  ///
  /// Por que campos na permuta, e não uma tabela de pedidos: o que a operação
  /// precisa saber é se ESTA permuta tem um pedido em aberto agora, e a
  /// história de todos eles já é gravada em `BarterEvent`, que é onde a
  /// trajetória mora. Uma tabela daria consulta por pedido, que ninguém faz.
  changeRequestStatus String?
  changeRequestNote   String?
  changeRequestBy     String?
  changeRequestById   Int?
  changeRequestAt     DateTime?
  changeRequestFrom   String?
  /// A resposta do admin ao pedido — obrigatória na recusa, que é a única em
  /// que ela sobrevive: o aceite fala pelo próprio efeito (a permuta voltou a
  /// ser rascunho, e o consultor a tem de novo nas mãos).
  changeRequestReply  String?

  createdAt DateTime @default(now())

  items  BarterItem[]
  events BarterEvent[]

  /// OS PEDIDOS DE FORA DO BARTER feitos nesta permuta — o consultor pedindo um
  /// produto que a tabela da versão não tem. Ver BarterProductRequest.
  ///
  /// Lista, e não um campo de estado como o pedido de alteração, porque a
  /// pergunta é outra: ali interessa se ESTA permuta tem um pedido em aberto
  /// agora (um de cada vez, e o anterior some quando o seguinte nasce); aqui
  /// cada pedido é um item que entra — ou não — na permuta, e dois pedidos
  /// diferentes convivem sem nenhuma relação entre si.
  productRequests BarterProductRequest[]

  /// AS NOTAS FISCAIS desta permuta — o que o faturamento produziu, com o
  /// arquivo de cada uma anexado.
  ///
  /// LISTA, e não um número de nota na permuta, porque a operação é assim: o
  /// produtor retira os insumos em mais de um carregamento, cada retirada sai
  /// com a sua nota, e às vezes uma delas é cancelada e reemitida. Enquanto o
  /// número foi um campo de texto (e era, dentro da cédula), a segunda nota não
  /// tinha onde entrar — e a cédula citava uma só como origem de uma dívida
  /// formada por três.
  invoices BarterInvoice[]

  /// AS PEÇAS DA ANÁLISE DE CRÉDITO que o comitê juntou para decidir esta
  /// permuta — a consulta ao Serasa, o endividamento dentro da cooperativa. Ver
  /// BarterCreditFile, inclusive para quem as enxerga.
  creditFiles BarterCreditFile[]

  /// Os AVISOS que esta permuta gerou — ver `Notice`.
  notices Notice[]

  /// A CÉDULA DE PRODUTO RURAL desta permuta, quando o consultor já começou a
  /// preenchê-la. Uma só, e opcional: a permuta existe e anda sem CPR até o
  /// faturamento — é a EMISSÃO que a exige, não o registro.
  cpr BarterCpr?

  @@index([versionId])
  @@index([unitId])
  // A fila do gerente: as permutas endereçadas a ele que ainda esperam parecer.
  @@index([managerId, status])
  // As filas do comitê e do faturista: elas não têm destinatário — quem as
  // define é o ESTADO ("as que esperam decisão", "as aprovadas a faturar"), e
  // esta é a consulta que as duas telas fazem o tempo todo.
  @@index([status, createdAt])
  // A fila do admin: os pedidos de alteração em aberto. Ela é pequena e some
  // sozinha (o pedido decidido sai do `open`), mas é varrida sobre a tabela
  // inteira de permutas toda vez que o admin abre a tela.
  @@index([changeRequestStatus, changeRequestAt])
}

/// O HISTÓRICO DA PERMUTA — cada passagem dela de um estado para o outro.
///
/// É PARTE DO DOCUMENTO, e não da trilha de segurança. Os dois registros
/// existem e são diferentes de propósito:
///
/// - `AuditLog` responde "quem mexeu no sistema": é global, só o admin lê, e a
///   gravação é best-effort — perder uma linha não pode derrubar o ato;
/// - `BarterEvent` responde "por onde esta permuta passou": é do registro,
///   qualquer um que enxergue a permuta o enxerga junto, e ele é gravado na
///   MESMA TRANSAÇÃO da mudança de estado. Sem o evento não há mudança — é o que
///   torna o histórico completo por construção, em vez de por hábito.
///
/// É também o que o faturista recebe: as peças das etapas anteriores (o pedido,
/// o parecer, a decisão) na ordem em que aconteceram, sem depender de campo
/// nenhum ter sobrevivido a uma edição.
///
/// Tudo é SNAPSHOT em texto — nome e papel de quem agiu ficam congelados, como
/// no AuditLog, porque a linha precisa continuar legível depois que a conta for
/// excluída. Não há rota que edite nem apague evento.
model BarterEvent {
  id       Int    @id @default(autoincrement())
  barterId Int
  barter   Barter @relation(fields: [barterId], references: [id], onDelete: Cascade)

  /// O ato praticado — ver BARTER_ACTION em barters/barter-workflow.ts.
  action String

  /// A transição. `fromStatus` é null no registro, que não vem de estado nenhum.
  fromStatus String?
  toStatus   String

  actorId   Int?
  actorName String
  actorRole String

  /// O texto que acompanhou o ato (o parecer, a observação da decisão, a nota do
  /// faturamento). É a MESMA coisa que está no campo da permuta, e está aqui de
  /// novo porque o campo é sobrescrito e o evento não.
  note String?

  at DateTime @default(now())

  @@index([barterId, at])
}

/// UM AVISO para uma pessoa — algo aconteceu numa permuta que ela acompanha, e
/// não há nada para ela fazer a respeito.
///
/// Existe para o GERENTE no desvio das exigências: o comitê devolve a permuta
/// ao consultor e ela volta direto ao comitê, sem passar pela mesa dele. Sem o
/// aviso, o gerente que deu o parecer descobriria pela lista que a permuta do
/// time dele andou para trás e voltou — ou não descobriria. Ele não é chamado a
/// agir (o parecer dele continua valendo); ele é avisado.
///
/// É IN-APP, e só: aparece no painel de quem o recebe e some quando a pessoa o
/// dispensa (`readAt`). Push e e-mail ficam para quando o uso real mostrar que
/// precisa chegar com o app fechado — ver docs/notificacoes-a-adicionar.md.
///
/// O TEXTO é snapshot, como o do evento: a frase diz o que aconteceu no dia, e
/// continua dizendo depois que a permuta andar. `barterCode` também, para o
/// aviso continuar legível se a permuta for excluída.
model Notice {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  barterId   Int?
  barter     Barter? @relation(fields: [barterId], references: [id], onDelete: Cascade)
  barterCode String  @default("")

  message String

  createdAt DateTime  @default(now())
  /// Quando a pessoa o dispensou. Null é "ainda não visto".
  readAt    DateTime?

  // O painel pergunta "quais avisos desta pessoa ainda não foram vistos?".
  @@index([userId, readAt])
}

/// Item da permuta com snapshots imutáveis de nome/unidade/preço. O preço é
/// congelado aqui — e não lido da tabela da versão — porque publicar a versão
/// seguinte não pode reescrever o que já foi acordado.
///
/// A LINHA DE `kind: "grain"` É O PAGAMENTO — quantas sacas da cultura da
/// permuta cobrem o custo: `productId` é o grão da safra e `unitValue` a cotação
/// com que o custo foi convertido, congelados como todo o resto.
model BarterItem {
  id          Int      @id @default(autoincrement())
  barterId    Int
  barter      Barter   @relation(fields: [barterId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind        String
  productName String
  /// O CÓDIGO do produto no momento do registro (o `sku` do catálogo).
  ///
  /// Snapshot pelo mesmo motivo do nome e do preço: é por ele que o estoque, a
  /// nota e a conferência no balcão encontram o item, e ele precisa continuar
  /// dizendo o que dizia no dia do acordo — inclusive depois que o cadastro for
  /// recodificado ou o produto excluído (o FK vira null e sobra este texto).
  ///
  /// `null` nos itens anteriores a este campo e nos produtos sem código: um
  /// traço na tela é honesto, um código inventado não.
  productSku  String?
  unit        String
  quantity    Float
  unitValue   Float

  /// Este item veio de FORA DO BARTER — de um pedido do consultor que o admin
  /// atendeu (ver BarterProductRequest), e não da tabela de valores da versão.
  ///
  /// É o fato, gravado como fato: `requestId` ao lado é a PISTA de qual pedido o
  /// trouxe, e vira null se o pedido sumir. A marca não pode sumir junto — ela é
  /// o que explica, no comprovante e na conferência do balcão, um item que não
  /// está na lista de preços da praça e cujo valor ninguém encontra na tabela.
  ///
  /// `productId` é null nestes itens: eles não entram no catálogo. O catálogo é
  /// a lista do FORNECEDOR, carregada da planilha dele; um item pedido para uma
  /// permuta só não é um produto da praça, e cadastrá-lo faria o relatório de
  /// preço e a carga seguinte tropeçarem num produto que ninguém vende.
  offBarter Boolean               @default(false)
  requestId Int?
  request   BarterProductRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /// Esta linha é o SEGURO AGRÍCOLA — não um insumo retirado.
  ///
  /// Ela é `kind: "input"` de propósito, e a marca ao lado é o que a distingue.
  /// `kind` responde "esta linha forma custo ou paga a permuta?", e o seguro
  /// forma custo como qualquer outra coisa que a empresa adianta: ele soma no
  /// total, vira sacas e dimensiona o penhor junto com o restante. Um terceiro
  /// `kind` obrigaria toda soma do sistema — a remontagem do rascunho, o
  /// recálculo do grão, o comprovante, o app — a aprender que existe uma
  /// terceira espécie de linha que também é custo; e a primeira que esquecesse
  /// simplesmente deixaria o seguro de fora da conta, em silêncio.
  ///
  /// É a mesma escolha de `offBarter`, e pelo mesmo motivo: o que ela explica é
  /// uma linha cujo valor não está em tabela de preço nenhuma. `quantity` é a
  /// área plantada da permuta (ha) e `unitValue` é a taxa do município —
  /// juntas, elas são a conta inteira, legível no comprovante sem nota de
  /// rodapé.
  ///
  /// `productId` null, como nos itens de fora do Barter: o seguro não é produto
  /// do catálogo do fornecedor (ver `InsuranceRate`).
  insurance Boolean @default(false)

  /// O VALOR DE TABELA deste item, quando o admin escreveu outro por cima.
  ///
  /// Null é o caso normal: o item vale o que a versão do Barter diz, e
  /// `unitValue` é a única verdade. Preenchido, ele guarda o que a tabela dizia
  /// ANTES de o admin atender um pedido de alteração mexendo no valor (ver
  /// `POST /barters/:code/change-request/prices`) — e é o que permite à tela
  /// mostrar "R$ 110,00 (tabela: R$ 120,00)" em vez de um número sem história.
  ///
  /// Guardado só na PRIMEIRA sobrescrita: o que interessa é de onde o valor
  /// saiu, e não a lista de tentativas. Uma segunda correção do mesmo item
  /// continua tendo partido da tabela.
  listValue Float?

  @@index([requestId])
}

/// O PEDIDO DE FORA DO BARTER — o consultor pede um produto que a tabela da
/// versão não tem, e o admin o adiciona ÀQUELA permuta, com o valor que acertou.
///
/// Ele existe porque a tabela do Barter é uma lista fechada e a lavoura não é: o
/// produtor precisa de um adjuvante específico, de um serviço que não foi
/// lançado, de uma semente que o fornecedor só cota sob encomenda. Sem este
/// caminho, as saídas eram duas e as duas ruins — deixar o item fora da permuta
/// (e o produtor compra à vista em outro lugar, que é a venda que o Barter
/// existe para trazer) ou lançar o produto na versão vigente para todo mundo,
/// transformando uma negociação pontual em preço de praça.
///
/// ELE É DA PERMUTA, e não do produtor nem do catálogo. O valor acertado aqui
/// vale para ESTA permuta e morre com ela: foi cotado para esta quantidade,
/// nesta data, neste negócio. Outra permuta do mesmo produtor pede de novo — e
/// é assim que se percebe que o item passou a ser rotina e merece entrar na
/// próxima versão do Barter.
///
/// Quem pede é o CONSULTOR que registrou; quem decide é o ADMIN, e o que ele
/// decide é um VALOR — diferente do pedido de alteração, em que ele decide se o
/// trabalho dos outros postos será refeito. Aqui ele não desfaz nada: o item
/// entra na permuta onde ela está.
model BarterProductRequest {
  id       Int    @id @default(autoincrement())
  barterId Int
  barter   Barter @relation(fields: [barterId], references: [id], onDelete: Cascade)

  /// O QUE o consultor pediu, escrito por ele: o nome do produto, a unidade em
  /// que ele o conhece e quanto o produtor quer. Texto livre de propósito — ele
  /// está pedindo justamente o que não existe em lista nenhuma para escolher.
  ///
  /// O admin pode corrigir os três ao atender (a descrição do fornecedor é outra,
  /// a embalagem é em 20 l e não em litro), e o que fica gravado é o que ELE
  /// escreveu: é esse o item que entra na permuta e é por ele que o produtor vai
  /// perguntar no balcão.
  productName String
  unit        String
  quantity    Float

  /// O CÓDIGO do fornecedor, quando o admin o tem na hora de atender. É a mesma
  /// chave de `BarterItem.productSku`, e serve à mesma pessoa: quem separa o
  /// item no depósito e o bate contra a nota.
  sku String?

  /// O que o consultor tem a dizer sobre o pedido, quando tem.
  ///
  /// OPCIONAL, ao contrário do pedido de alteração: ali o texto é o pedido
  /// inteiro (sem ele o admin não sabe sequer do que se trata); aqui o pedido é
  /// o produto e a quantidade, e eles falam por si. Exigir um parágrafo para
  /// pedir 20 t de ureia produziria quinhentos "o produtor quer" no histórico.
  note String?

  /// `open` (na mesa do admin), `added` (atendido: o item está na permuta) ou
  /// `denied` (recusado, com o motivo em `reply`).
  ///
  /// As duas decisões SOBREVIVEM, e aqui isso é diferente do pedido de
  /// alteração — onde o aceite some porque o efeito dele (a permuta virou
  /// rascunho) conta a história sozinho. O atendido precisa continuar existindo
  /// porque ele é a ORIGEM de um item da permuta: é ele que diz de onde veio um
  /// insumo que não está na tabela do Barter, e é dele que a remontagem do
  /// rascunho tira o item de volta (ver `replaceInputs`).
  status String @default("open")

  requestedBy   String
  requestedById Int?
  requestedAt   DateTime @default(now())

  /// A RESPOSTA DO ADMIN: quem, quando, e o motivo — obrigatório na recusa, como
  /// em toda resposta que fecha a porta de alguém.
  decidedBy   String?
  decidedById Int?
  decidedAt   DateTime?
  reply       String?

  /// O VALOR (R$ por unidade) que o admin acertou para este item nesta permuta.
  /// Null enquanto o pedido não foi atendido — e um valor "provisório" antes
  /// disso seria um preço que ninguém combinou.
  unitValue Float?

  /// O item que este pedido virou. Lista, e não um só, pelo que o schema
  /// permite: na prática é um item — e é `replaceInputs` que o recria quando o
  /// consultor remonta o rascunho, sempre um por pedido atendido.
  items BarterItem[]

  // A fila do admin: os pedidos de produto em aberto, varridos sobre a tabela
  // inteira toda vez que ele abre a tela.
  @@index([status, requestedAt])
  @@index([barterId])
}

/// UM ARQUIVO ANEXADO ao registro — hoje a nota fiscal do faturamento e o SCR
/// do produtor.
///
/// O CONTEÚDO fica no banco, e essa é uma escolha, não uma falta de opção. Os
/// dois anexos são pequenos (um DANFE em PDF, um relatório do Bacen de duas
/// páginas), são POUCOS por permuta e são PROVA: eles precisam existir enquanto
/// o título existir. Guardá-los aqui os põe dentro do mesmo backup, da mesma
/// transação e do mesmo controle de acesso do resto — um bucket exigiria
/// credencial, ciclo de vida próprio e uma segunda resposta para "quem pode ler
/// este arquivo?", que é justamente a pergunta que já tem dono aqui (o escopo da
/// permuta).
///
/// O TAMANHO é travado na entrada (ver MAX_ATTACHMENT_BYTES em barters.service),
/// e não no banco: o limite é sobre a requisição, que é onde ele dói.
///
/// É TABELA À PARTE, e não colunas dentro da nota, porque `Bytes` numa tabela
/// consultada em lista viria junto em toda leitura — a listagem de permutas
/// carregaria megabytes de PDF para desenhar uma linha de tabela. Aqui o
/// conteúdo só é lido por quem pede o arquivo.
model BarterFile {
  id Int @id @default(autoincrement())

  /// O nome COM QUE O ARQUIVO CHEGOU. É o que a tela mostra e o que o download
  /// devolve — quem anexou reconhece o próprio arquivo pelo nome que deu a ele.
  fileName String

  /// O tipo declarado (`application/pdf`, `image/jpeg`…). Guardado porque é o
  /// que o download precisa devolver: sem ele, o navegador baixa um arquivo que
  /// não sabe abrir.
  contentType String

  /// O tamanho em bytes, guardado para a tela não precisar ler o conteúdo só
  /// para dizer "2,4 MB" numa lista.
  size Int

  content Bytes

  /// Quem anexou, congelado em texto pelo mesmo motivo de `Barter.invoicedBy`.
  uploadedBy   String
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  /// Os donos possíveis de um arquivo hoje. São relações 1-1 (o `@unique` mora
  /// do lado de lá), e um arquivo tem no máximo uma delas: ele é a nota fiscal,
  /// ou o SCR, ou a cédula assinada, ou o comprovante do registro.
  ///
  /// As relações da cédula são NOMEADAS porque são três para o mesmo modelo, e
  /// sem nome o Prisma não teria como saber qual coluna é qual.
  invoice          BarterInvoice?
  cprScr           BarterCpr?        @relation("CprScr")
  cprSigned        BarterCpr?        @relation("CprSigned")
  cprRegistry      BarterCpr?        @relation("CprRegistry")
  /// …ou o SCR de um AVALISTA, ou o documento de um BEM dado em hipoteca —
  /// os anexos que o comitê passa a exigir junto com o aval e a hipoteca.
  guarantorScr     CprGuarantor?     @relation("GuarantorScr")
  mortgageDocument CprMortgage?      @relation("MortgageDocument")
  /// …ou uma das peças da ANÁLISE DE CRÉDITO que o comitê juntou à permuta.
  credit           BarterCreditFile?
  /// …ou a APÓLICE do seguro, que a seguradora anexa à permuta.
  policyOf         Barter?           @relation("BarterPolicy")
}

/// UMA PEÇA DA ANÁLISE DE CRÉDITO — o que o comitê junta à permuta para decidir:
/// a consulta ao Serasa, o endividamento do produtor dentro da cooperativa, e o
/// que mais a reunião tiver pedido.
///
/// Ela existe porque a decisão do comitê era tomada sobre documentos que não
/// estavam aqui. A permuta chegava com o pedido do consultor e o parecer do
/// gerente; o resto — a consulta de crédito, o extrato do que o produtor já deve
/// à cooperativa, a certidão que alguém puxou — circulava por e-mail entre os
/// integrantes e morria na caixa de quem convocou a reunião. Meses depois, a
/// pergunta "com base em quê vocês aprovaram isto?" não tinha onde ser
/// respondida: o registro guardava a decisão e não guardava a prova.
///
/// LISTA, e não um par de anexos fixos, pelo mesmo motivo das lavouras da
/// cédula: os dois documentos que a operação nomeia hoje (Serasa e endividamento
/// interno) são os do caso comum, e a reunião que pede um terceiro não tem onde
/// pôr a certidão de ônus que o gerente trouxe.
///
/// QUEM VÊ é o comitê e o admin, e SÓ eles. Este é o único anexo do sistema com
/// leitura restrita, e a restrição é a própria natureza da peça: consulta de
/// crédito e endividamento são a vida financeira do produtor, colhidas para uma
/// decisão de crédito. O consultor que atende o cliente não as vê — não por
/// desconfiança, mas porque elas não são dele: ele leva ao produtor a decisão,
/// não o dossiê que a fundamentou. Ver `bartersCreditRead` em policy.ts.
///
/// NÃO É O SCR. O SCR (`BarterCpr.scrFile`) é peça do TÍTULO: ele acompanha a
/// cédula, é exigido para emiti-la e quem o anexa é quem a preenche. Este é
/// insumo da DECISÃO, e ele acontece antes — muitas vezes sobre uma permuta que
/// vai ser negada, e que portanto nunca terá cédula nenhuma.
model BarterCreditFile {
  id       Int    @id @default(autoincrement())
  barterId Int
  barter   Barter @relation(fields: [barterId], references: [id], onDelete: Cascade)

  /// QUE PEÇA é esta — `serasa`, `indebtedness` ou `other`. Ver
  /// `barters/credit-file.ts`, que é onde a lista e os rótulos moram.
  ///
  /// String, e não `enum` do Postgres, pelo mesmo motivo dos outros "enums"
  /// deste schema: a reunião nomeia uma peça nova e isso não pode pedir
  /// migration.
  kind String

  /// O que o comitê tem a dizer sobre este documento (a data da consulta, o
  /// valor apurado, de onde o extrato veio). Opcional.
  note String?

  /// O ARQUIVO. Anexá-lo É o ato, como na nota fiscal: a rota exige o arquivo, e
  /// um registro sem documento seria o e-mail de volta.
  ///
  /// `onDelete: Cascade` e `@unique`: o arquivo pertence a esta peça e a mais
  /// nada. Diferente do SCR, que é `SetNull` porque a cédula sobrevive à perda
  /// do anexo com uma pendência a mostrar — aqui não há o que sobreviver: sem o
  /// documento, a peça não é nada.
  fileId Int        @unique
  file   BarterFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  attachedBy   String
  attachedById Int?
  attachedAt   DateTime @default(now())

  @@index([barterId])
}

/// UMA NOTA FISCAL do faturamento desta permuta, com o arquivo dela.
///
/// Ela é o que o posto do faturista PRODUZ, e é a origem da dívida que a cédula
/// afirma (cláusula VII). Enquanto o número da nota foi um campo de texto dentro
/// da CPR, três coisas estavam erradas ao mesmo tempo: quem o digitava não era
/// quem emitia a nota, só cabia UMA, e não havia o documento — só o número.
///
/// A CHAVE do mundo real é número + série, e ela não é única aqui de propósito:
/// a unicidade da nota fiscal é do emissor dela (a empresa, perante o fisco), e
/// não deste sistema. Uma trava aqui recusaria, por exemplo, a nota reemitida
/// com o mesmo número em outra série — e o erro apareceria como "não foi
/// possível anexar", sem dizer por quê.
model BarterInvoice {
  id       Int    @id @default(autoincrement())
  barterId Int
  barter   Barter @relation(fields: [barterId], references: [id], onDelete: Cascade)

  /// O número e a série, como saem no documento. Texto, e não inteiro: nota
  /// fiscal tem zero à esquerda, e perdê-los faria a busca no sistema fiscal
  /// não encontrar nada.
  number String
  series String @default("")

  /// A DUPLICATA que a nota originou, quando há. A cédula a cita ao lado da
  /// nota, e ela é da mesma natureza — documento do faturamento, não da
  /// negociação. Opcional: nem toda venda gera duplicata.
  duplicateNumber String @default("")

  /// Quando a nota foi emitida e por quanto. O valor é o DA NOTA, e pode não
  /// bater com o total da permuta — é o que acontece quando a retirada é
  /// parcial, que é justamente o caso em que há mais de uma.
  issuedAt DateTime?
  value    Float     @default(0)

  /// O que o faturista tem a dizer sobre esta nota (retirada parcial, nota de
  /// devolução, remessa). Opcional — a maioria não tem o que explicar.
  note String?

  /// O ARQUIVO. Anexá-lo É o ato — a rota que cria a nota exige o arquivo, e um
  /// registro sem documento seria de novo o número solto que este modelo existe
  /// para substituir.
  ///
  /// A coluna é nulável mesmo assim, e por um motivo só: as notas HERDADAS do
  /// campo de texto que ficava dentro da cédula não têm arquivo nenhum (ver a
  /// migration). Recusá-las apagaria um número que alguém digitou; aceitá-las
  /// sem arquivo deixa a pendência visível na tela de quem pode resolvê-la.
  fileId Int?        @unique
  file   BarterFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  attachedBy   String
  attachedById Int?
  attachedAt   DateTime @default(now())

  @@index([barterId])
}

/// A CREDORA — a empresa que recebe o grão, como os documentos a nomeiam.
///
/// A CPR nomeia duas partes: o EMITENTE (o produtor, que muda a cada cédula) e a
/// CREDORA, que é sempre a mesma e aparece em quatro cláusulas do documento — a
/// qualificação (II), a promessa de entrega, o local de entrega (V-d) e o foro
/// (XX) —, com a qualificação por inteiro repetida nas três primeiras.
///
/// É CADASTRO, e não campo de formulário: pedir a razão social a cada cédula é
/// pedir que alguém digite o CNPJ do próprio empregador trezentas vezes, e a
/// trezentésima primeira sai com um dígito trocado num título de crédito.
///
/// LINHA ÚNICA, pelo mesmo desenho do comitê (`isSingleAccount` em roles.ts): a
/// rota é `/creditor`, no singular, sem `:id` e sem exclusão. Uma instalação
/// serve uma empresa — duas credoras cadastradas fariam a cédula ter de
/// escolher, e nada no documento diz qual. O dia em que a mesma instalação
/// servir a mais de uma, isto vira lista e a permuta passa a apontar para uma
/// delas; até lá, a unicidade é a afirmação certa.
///
/// Quem escreve são o ADMIN e o FATURISTA (`creditor.manage`). O segundo está
/// aí de propósito: quem percebe que o CNPJ saiu errado é quem monta a cédula.
model Creditor {
  /// Sempre 1. A linha é única, e o id fixo é o que torna a leitura um
  /// `findUnique` em vez de um `findFirst` com ordenação — que é a mesma
  /// diferença entre "a credora" e "alguma credora".
  id Int @id @default(1)

  name          String @default("")
  cnpj          String @default("")
  address       String @default("")
  addressNumber String @default("")
  /// Município/UF da sede, no mesmo formato do produtor ("Maringá/PR").
  city          String @default("")

  /// O FORO eleito (cláusula XX da CPR). Quase sempre a comarca da sede — e por
  /// isso o vazio vale como `city` na leitura —, mas é escolha contratual, e há
  /// credora que elege outra.
  forum String @default("")

  /// A MARGEM DE SEGURANÇA DO PENHOR (%) — quanto a mais de área a credora exige
  /// além da que a produção estimada justifica.
  ///
  /// A área estimada (`sacas ÷ produtividade`) é o que a lavoura precisa ter se
  /// tudo correr bem. Como nem tudo corre bem — quebra de safra, sinistro, uma
  /// produtividade que veio otimista —, a empresa penhora uma folga por cima
  /// dela. Zero é uma resposta legítima: é a credora que decide não exigir folga
  /// nenhuma, e por isso este campo não entra em `creditorGaps()`.
  ///
  /// NÃO É A RESERVA LEGAL, e o nome é escolhido para não confundir os dois. A
  /// reserva legal é do Código Florestal: o percentual do IMÓVEL que tem de ficar
  /// em vegetação nativa (20% no Sul/Sudeste, 35% ou 80% na Amazônia). Ela é
  /// atributo de cada matrícula, imposta por lei, e o efeito dela é o oposto —
  /// diz que parte da área registrada NÃO é plantável. Esta aqui é apetite de
  /// risco da credora, muda quando a diretoria muda de ideia, e vale para todas
  /// as matrículas igualmente.
  ///
  /// Mora na CREDORA porque é política da empresa, e não da safra: a folga que se
  /// exige de um produtor é a mesma que se exige de todos, e ela não muda porque
  /// o fornecedor republicou a tabela de preços.
  pledgeMarginPercent Float @default(0)

  updatedAt DateTime @updatedAt

  /// Quem mexeu por último, congelado em texto pelo mesmo motivo de
  /// `Barter.invoicedBy`: a linha precisa continuar legível depois que a conta
  /// for excluída.
  updatedBy String @default("")
}

/// A CÉDULA DE PRODUTO RURAL (CPR) desta permuta — o que a permuta NÃO sabe.
///
/// A CPR é o título que formaliza a entrega do grão: o produtor emite, a empresa
/// é a credora, e o documento é registrado na B3 (ver a cláusula XIII do
/// modelo). Ela é o desfecho jurídico do que a permuta já acordou — e por isso
/// quase tudo o que ela precisa JÁ ESTÁ no registro: quem entrega
/// (`Barter.producerName`), quanto (o item de grão), a que preço
/// (`BarterItem.unitValue`), de que safra (`Barter.versionCode`).
///
/// O QUE FALTA é o que uma cédula exige e uma permuta não: a qualificação civil
/// do emitente (a lei pede nacionalidade, estado civil, profissão, RG e endereço
/// completo), as matrículas das lavouras dadas em penhor, os padrões de
/// qualidade do grão e o SCR do produtor. É ISSO que esta tabela guarda, e é
/// isso que o CONSULTOR preenche.
///
/// É DO CONSULTOR, e isso mudou de dono. Era do faturista, pelo argumento de que
/// o posto que emite documento para fora é o mesmo que emite a nota — e o
/// argumento não se sustentou: nada do que a cédula pede está na mesa de quem
/// fatura. A matrícula do imóvel, o nome do cônjuge, quem é o dono da área
/// arrendada, o SCR — quem tem isso é quem visita a fazenda. O faturista obtinha
/// tudo por telefone e digitava, e cada intermediação dessas é um RG com um
/// dígito trocado dentro de um título executável.
///
/// QUEM CONFERE é o EMISSOR, na hora de gerar (ver `bartersCprIssue`). É a mesma
/// divisão do parecer: quem conhece o cliente escreve, outro posto responde pelo
/// documento.
///
/// O QUE NÃO ESTÁ MAIS AQUI, e por quê:
///
/// - o NÚMERO DA NOTA e o da DUPLICATA: eles são do faturamento, e agora moram
///   em `BarterInvoice` — com o arquivo junto, e em lista, porque são várias;
/// - o VENCIMENTO: ele é o mesmo para todas as cédulas da versão do Barter (ver
///   `BarterVersion.cprDueDate`). `dueDate` continua abaixo, mas quem o escreve
///   é o servidor, copiando-o da versão — ele é o congelamento, não o campo.
///
/// UMA POR PERMUTA (`barterId @unique`): a CPR é o título daquela entrega, e
/// duas cédulas sobre o mesmo grão seriam duas cobranças do mesmo produto.
///
/// Nada aqui é snapshot. Ao contrário do resto da permuta, estes campos são um
/// RASCUNHO até o documento sair: o consultor digita, confere, corrige o RG que
/// veio errado. O congelamento acontece no documento emitido, e não na linha —
/// é a diferença entre o que ainda se está escrevendo e o que já foi assinado.
///
/// E porque é rascunho, ele é SALVÁVEL PELA METADE. O vazio (`""`, `0`, `null`)
/// significa "ainda não preenchido", e quem diz o que falta é `cprGaps()`, em
/// cpr.ts — não o banco, e não a validação de entrada. Exigir a cédula inteira
/// numa tacada só obrigaria o consultor a esperar a matrícula que o produtor vai
/// mandar amanhã para poder gravar a qualificação que ele tem na mão agora, e o
/// rascunho ficaria num papel ao lado do computador, que é onde ele estava antes
/// deste formulário.
model BarterCpr {
  id       Int    @id @default(autoincrement())
  barterId Int    @unique
  barter   Barter @relation(fields: [barterId], references: [id], onDelete: Cascade)

  /// O NÚMERO da cédula não está aqui: ele é da PERMUTA (`Barter.cprNumber`),
  /// gerado no registro — antes de existir rascunho para guardá-lo.

  /// A data da EMISSÃO ("Aos [DIA] dias do mês de [MÊS] de [ANO]") e o
  /// VENCIMENTO da entrega. São diferentes da data da permuta de propósito: a
  /// cédula é emitida quando o emissor a gera, e vence na colheita.
  ///
  /// `issuedAt` nasce com o dia em que o rascunho foi aberto, que é a resposta
  /// certa na esmagadora maioria das vezes e é editável nas outras.
  ///
  /// `dueDate` NÃO É CAMPO DE FORMULÁRIO, e essa é a correção: ele é copiado de
  /// `BarterVersion.cprDueDate` — o vencimento da versão — a cada gravação, até a
  /// cédula ser emitida. Depois disso ele congela, como tudo o que já foi
  /// assinado. Enquanto foi digitado cédula a cédula, duas CPRs da mesma safra
  /// saíam com vencimentos diferentes e ninguém tinha como saber qual estava
  /// certa.
  ///
  /// Nulável porque a versão pode ainda não ter a data acertada — e aí
  /// `cprGaps()` cobra, dizendo onde ela se resolve.
  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  /// A QUALIFICAÇÃO CIVIL do emitente. O cadastro de produtor tem nome,
  /// documento, fazenda e município — o suficiente para permutar, e não o
  /// suficiente para emitir título: a cédula qualifica a pessoa por inteiro.
  ///
  /// Fica AQUI, e não no produtor, porque quem preenche é o faturista e o
  /// cadastro é do admin (`producers.manage`). A repetição a cada CPR é
  /// resolvida pelo pré-preenchimento a partir da última cédula do mesmo
  /// produtor — ver `prefillFrom` em barters.service.ts —, não por dar ao
  /// faturista a caneta do cadastro.
  emitterNationality   String  @default("")
  emitterMaritalStatus String  @default("")
  emitterProfession    String  @default("")
  emitterRg            String  @default("")
  emitterAddress       String  @default("")
  emitterAddressNumber String  @default("")
  /// Município/UF, no mesmo formato do produtor ("Maringá/PR").
  emitterCity          String  @default("")
  /// A matrícula do emitente na cooperativa, que fecha o bloco de assinatura.
  /// Opcional: nem toda credora é cooperativa.
  emitterCoopId        String?

  /// A QUALIFICAÇÃO QUE A PROPOSTA PEDE E A CÉDULA NÃO IMPRIME.
  ///
  /// CNH, filiação e e-mail não aparecem em nenhuma cláusula do modelo — quem
  /// os pede é a planilha de proposta, e por trás dela o cartório (a filiação é
  /// o que individualiza um homônimo no registro) e a operação (o e-mail é por
  /// onde a assinatura eletrônica chega).
  ///
  /// Eles são COLETADOS e não SAEM, e essa diferença é deliberada: `cprGaps()`
  /// não os cobra, porque quem decide o que falta é o documento, e o documento
  /// não os usa. Se um dia uma cláusula precisar deles, é lá que a mudança
  /// acontece — aqui o dado já está.
  emitterCnh        String @default("")
  emitterFatherName String @default("")
  emitterMotherName String @default("")
  emitterEmail      String @default("")

  /// O LOCAL DA ENTREGA do grão (cláusula V, "d") — uma das FILIAIS
  /// cadastradas (`Unit`).
  ///
  /// É campo, e não a unidade de retirada da permuta, porque as duas coisas não
  /// são a mesma: retirar insumo na Filial 02 não obriga ninguém a entregar o
  /// grão lá. A unidade de retirada entra como SUGESTÃO no formulário (é o caso
  /// comum), e quem confirma é quem assina embaixo.
  ///
  /// Já foi texto livre, e a mesma filial saía escrita de três jeitos em três
  /// cédulas. Agora é a lista suspensa das unidades: `deliveryUnitId` é a
  /// escolha, e `deliveryPlace` é o NOME dela congelado na gravação — pelo
  /// motivo de `Barter.unitName`: excluir ou renomear a unidade não pode mudar
  /// o que a cédula diz. As cédulas do tempo do texto livre ficam com o texto e
  /// sem unidade.
  deliveryUnitId Int?
  deliveryUnit   Unit?  @relation("CprDeliveryUnit", fields: [deliveryUnitId], references: [id], onDelete: SetNull)
  deliveryPlace  String @default("")

  /// AS HIPOTECAS deixaram de ser um texto livre aqui: cada bem dado em
  /// hipoteca é um cadastro, com o documento anexado — ver `CprMortgage`.

  /// A ANUÊNCIA DO CÔNJUGE. Nulo quando não há — e "não há" é o caso comum, não
  /// uma pendência: só o emitente casado assina acompanhado.
  ///
  /// O estado civil e o endereço do cônjuge não estão aqui porque não são
  /// informação nova: o estado civil dele é o do emitente (é o que faz dele
  /// cônjuge) e o endereço é o mesmo domicílio conjugal. Pedi-los de novo abriria
  /// a chance de o casal morar em endereços diferentes NO DOCUMENTO.
  spouseName        String?
  spouseNationality String?
  spouseProfession  String?
  spouseDocument    String?
  /// O RG do cônjuge é da proposta, não da cédula: o modelo qualifica o cônjuge
  /// por CPF. Ver o bloco de CNH/filiação acima — mesma natureza.
  spouseRg          String?

  /// O PADRÃO DO GRÃO recebido (cláusula V, "c"). São exigências comerciais da
  /// credora, não do cadastro do produto: o mesmo grão é recebido com padrões
  /// diferentes conforme o ano e o contrato.
  ///
  /// `sackWeightKg` é o que converte sacas em quilos ("[QUANTIDADE] kg que
  /// corresponde a [Nº DE SACAS] sacas de [PESO POR SACA] kg cada"). 60 é o
  /// padrão do mercado e por isso é o default — mas é um valor da cédula, e não
  /// uma constante do código, porque semente e milho em big-bag fogem dele.
  sackWeightKg  Float  @default(60)
  cultivar      String @default("")
  /// Percentuais máximos tolerados e o teor de óleo padrão do grão. Zero é
  /// "ainda não preenchido", e não "sem tolerância": um padrão de umidade 0%
  /// recusaria a colheita inteira, então o número tem de ser digitado por
  /// alguém. Ver `cprGaps()`.
  maxMoisture   Float  @default(0)
  maxImpurities Float  @default(0)
  oilContent    Float  @default(0)

  /// O SCR DO PRODUTOR — o relatório do Sistema de Informações de Créditos do
  /// Banco Central, anexado à cédula. OBRIGATÓRIO.
  ///
  /// Ele é a fotografia do endividamento de quem vai emitir o título: quanto o
  /// produtor já deve, a quem, e em que situação. Uma CPR é crédito, e conceder
  /// crédito sem olhar o SCR é conceder no escuro — por isso ele é exigência de
  /// `cprGaps()` e não um anexo "quando houver".
  ///
  /// É ARQUIVO e não campo: o SCR é um documento emitido pelo Bacen, com data, e
  /// o que vale é o papel. Transcrever números dele para campos criaria uma
  /// segunda versão da informação, mais nova em aparência e sem autoridade
  /// nenhuma.
  ///
  /// `SetNull` no arquivo: apagar o anexo não pode apagar a cédula — o efeito
  /// certo é a cédula voltar a ter uma pendência, que é o que `cprGaps()` dirá.
  scrFileId Int?        @unique
  scrFile   BarterFile? @relation("CprScr", fields: [scrFileId], references: [id], onDelete: SetNull)

  /// A CÉDULA ASSINADA e o COMPROVANTE DO REGISTRO — os dois documentos que
  /// VOLTAM de fora depois que o título sai daqui.
  ///
  /// O sistema gera a cédula em branco e a devolve ao mundo; o que volta é papel
  /// com assinatura e, depois, com o carimbo do registro. Enquanto eles não
  /// tinham onde ficar, a permuta dizia "assinada" e "registrada" sem ter como
  /// provar nenhuma das duas — o documento morava no e-mail de alguém, e a
  /// segunda via saía do sistema em branco, diferente da que está com o
  /// produtor.
  ///
  /// O ASSINADO é obrigatório no ato de assinar e o do REGISTRO não é: o
  /// primeiro é a própria coisa que se está lançando (não há "assinada" sem o
  /// papel assinado), e o segundo é prova de um fato que o `cprRegistryNumber`
  /// já afirma — cartório que demora a devolver a via carimbada não pode travar
  /// o fim da linha.
  ///
  /// `SetNull` nos dois, como no SCR: apagar o arquivo não pode apagar a cédula.
  signedFileId Int?        @unique
  signedFile   BarterFile? @relation("CprSigned", fields: [signedFileId], references: [id], onDelete: SetNull)

  registryFileId Int?        @unique
  registryFile   BarterFile? @relation("CprRegistry", fields: [registryFileId], references: [id], onDelete: SetNull)

  /// A DATA DA CONSULTA do SCR — o relatório tem validade curta na prática, e
  /// "o SCR está anexado" não responde "de quando?". Opcional no rascunho, como
  /// o resto.
  scrConsultedAt DateTime?

  /// A APÓLICE do seguro (cláusula XVIII, "j") NÃO ESTÁ MAIS AQUI: o número é da
  /// SEGURADORA, informado junto com o documento, e mora na permuta
  /// (`Barter.insurancePolicyNumber`). A cédula o lê de lá, como lê as notas.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Quem preencheu por último, congelado em texto pelo mesmo motivo de
  /// `Barter.invoicedBy`: a linha precisa continuar legível depois que a conta
  /// for excluída.
  filledBy   String
  filledById Int?

  areas      CprArea[]
  guarantors CprGuarantor[]
  mortgages  CprMortgage[]
}

/// O AVALISTA — quem garante a obrigação do emitente com o próprio patrimônio.
///
/// Ele só existe quando o COMITÊ exige aval (`Barter.requiresGuarantor`), e aí
/// ele ASSINA a cédula: o bloco dele (e o da anuência do cônjuge, quando
/// casado) sai junto com os do emitente. O aval numa cédula é dado pela
/// assinatura no título — é o bloco que faz dele avalista.
///
/// Ele tem SCR PRÓPRIO, pelo mesmo motivo do emitente: quem garante a dívida
/// com o próprio patrimônio é avaliado pelo endividamento dele. Sem o anexo, a
/// cédula não volta ao comitê nem é emitida (ver `cprGapsOf`).
///
/// TEM IDENTIDADE (`id`) que sobrevive às gravações do formulário, ao contrário
/// das lavouras: o SCR mora nele, e apagar e recriar a lista a cada "Salvar"
/// levaria o anexo junto. Ver `saveCpr`.
///
/// É LISTA, e não um bloco fixo, pelo mesmo motivo das lavouras: a proposta traz
/// um avalista porque o exemplo tinha um. Aval de casal são dois, e uma operação
/// grande pede três.
///
/// A FORMA é a mesma da qualificação do emitente, campo por campo, e isso é uma
/// afirmação sobre o domínio: avalista e emitente são a mesma coisa para o
/// direito — pessoas que se obrigam —, e o que os separa é o papel, não os
/// dados.
model CprGuarantor {
  id    Int       @id @default(autoincrement())
  cprId Int
  cpr   BarterCpr @relation(fields: [cprId], references: [id], onDelete: Cascade)

  /// A ordem em que ele foi acrescentado — a mesma razão de `CprArea.position`.
  position Int @default(0)

  name          String @default("")
  document      String @default("")
  rg            String @default("")
  cnh           String @default("")
  nationality   String @default("")
  profession    String @default("")
  maritalStatus String @default("")
  fatherName    String @default("")
  motherName    String @default("")
  email         String @default("")
  address       String @default("")
  addressNumber String @default("")
  city          String @default("")

  /// O CÔNJUGE DO AVALISTA. O aval de quem é casado costuma exigir a anuência
  /// do cônjuge pelo mesmo motivo do emitente — há regime de bens no meio.
  spouseName        String @default("")
  spouseDocument    String @default("")
  spouseRg          String @default("")
  spouseNationality String @default("")
  spouseProfession  String @default("")

  /// O SCR DO AVALISTA — `SetNull` como o do emitente: apagar o arquivo volta
  /// a pendência, não apaga o avalista.
  scrFileId Int?        @unique
  scrFile   BarterFile? @relation("GuarantorScr", fields: [scrFileId], references: [id], onDelete: SetNull)

  @@index([cprId, position])
}

/// UM BEM DADO EM HIPOTECA — o que o comitê exige quando pede hipoteca
/// (`Barter.requiresCollateral`).
///
/// Era um texto livre na cédula ("Hipoteca de 1º grau sobre a matrícula…"), e
/// texto livre não se confere: ninguém sabia se a matrícula estava lá, de quem
/// era o imóvel, quanto valia, nem havia onde guardar a certidão. Agora é um
/// CADASTRO, campo por campo, com o DOCUMENTO do bem anexado (a matrícula
/// atualizada, a certidão de ônus) — e cada campo vazio é uma pendência dita.
///
/// É LISTA pelo mesmo motivo das lavouras: a hipoteca pode recair sobre mais de
/// um imóvel. E tem IDENTIDADE estável, como o avalista, porque o anexo mora
/// nele.
///
/// NÃO SAI NA CÉDULA: o modelo em uso não tem cláusula de hipoteca, e inventar
/// uma seria escrever garantia nova num título executável. A hipoteca se
/// constitui na escritura e no registro do imóvel; aqui ela é conferida.
model CprMortgage {
  id    Int       @id @default(autoincrement())
  cprId Int
  cpr   BarterCpr @relation(fields: [cprId], references: [id], onDelete: Cascade)

  /// A ordem em que ele foi acrescentado — a mesma razão de `CprArea.position`.
  position Int @default(0)

  /// O BEM por extenso: "Imóvel rural — Fazenda Boa Vista, 120 ha".
  description      String @default("")
  /// A MATRÍCULA do imóvel e a COMARCA do registro — o que o individualiza no
  /// cartório, como nas lavouras do penhor.
  registryNumber   String @default("")
  registryDistrict String @default("")
  /// Município/UF onde o bem está.
  city             String @default("")
  /// O PROPRIETÁRIO — nem sempre o emitente: o imóvel do pai, o do sócio.
  ownerName        String @default("")
  ownerDocument    String @default("")
  /// O VALOR DE AVALIAÇÃO (R$). Zero é "não informado" — nenhum bem vale zero.
  appraisedValue   Float  @default(0)

  /// O DOCUMENTO do bem — a matrícula atualizada, a certidão de ônus reais.
  documentFileId Int?        @unique
  documentFile   BarterFile? @relation("MortgageDocument", fields: [documentFileId], references: [id], onDelete: SetNull)

  @@index([cprId, position])
}

/// UMA LAVOURA dada em penhor na cédula — o "(i)", o "(ii)" e quantos mais
/// houver do "Local da Lavoura" (cláusula V, "b", repetido na VI).
///
/// É TABELA, e não dois blocos de campos, porque o modelo do documento é uma
/// enumeração: o produtor planta em quantas áreas plantar, e o texto as lista.
/// Com campos fixos, a terceira área não teria onde entrar — e a segunda ficaria
/// vazia na maioria das cédulas, que é o outro lado do mesmo erro.
model CprArea {
  id    Int       @id @default(autoincrement())
  cprId Int
  cpr   BarterCpr @relation(fields: [cprId], references: [id], onDelete: Cascade)

  /// A ORDEM em que a área aparece no documento. Ela é citada por posição no
  /// texto ("(i)", "(ii)"), então a ordem é conteúdo, e não apresentação.
  position Int @default(0)

  /// Onde fica: a localidade (o nome do lugar, "Água Boa", "Linha São João") e o
  /// município/UF.
  locality String
  city     String

  /// A área PLANTADA nesta matrícula, em hectares. Não é a área do imóvel nem a
  /// área plantada da permuta (`Barter.plantedAreaHa`, que é a soma e serve aos
  /// mínimos por hectare): é quanto desta matrícula está sob penhor.
  areaHa Float

  /// Se o plantio ocupa só parte do imóvel — o "dentro de uma área maior" do
  /// modelo. Muda a frase do documento, e é a diferença entre penhorar a lavoura
  /// e parecer penhorar a fazenda inteira.
  withinLargerArea Boolean @default(false)

  /// O REGISTRO DO IMÓVEL: matrícula, livro e a comarca do cartório. É o que
  /// individualiza a garantia — sem matrícula, o penhor não se registra.
  registryNumber   String
  registryBook     String
  registryDistrict String

  owners CprAreaOwner[]

  @@index([cprId, position])
}

/// O PROPRIETÁRIO de uma das lavouras, com o CPF/CNPJ dele.
///
/// Lista, e não um par de campos, pelo mesmo motivo das áreas: o modelo traz
/// dois proprietários porque o exemplo tinha dois. Imóvel rural em nome do casal
/// tem dois; em espólio ou herança, tem seis.
///
/// Ele NÃO é o emitente: a lavoura penhorada costuma ser arrendada, e é
/// exatamente por isso que o documento nomeia o dono do imóvel separadamente de
/// quem planta.
model CprAreaOwner {
  id     Int     @id @default(autoincrement())
  areaId Int
  area   CprArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  position Int    @default(0)
  name     String
  /// CPF ou CNPJ, com a pontuação que o faturista digitar — é o que sai
  /// impresso. Aqui não há unicidade a defender (o proprietário não é cadastro),
  /// então não existe a coluna só-dígitos de `Producer`.
  document String

  @@index([areaId, position])
}

/// Trilha de AUDITORIA dos atos sensíveis: quem provisionou, redefiniu senha,
/// excluiu usuário e quem decidiu permuta.
///
/// Existe porque redefinir senha é a primitiva de tomada de conta do sistema:
/// ela sorteia uma senha nova e derruba as sessões abertas do titular. Sem
/// registro, uma sessão de admin comprometida faria isso com qualquer usuário
/// e não sobraria como reconstruir o que aconteceu — o log HTTP vai para a
/// saída padrão, é volátil e nem sabe QUEM chamou.
///
/// Tudo aqui é SNAPSHOT em texto, não relação: a linha precisa continuar
/// legível depois que o autor ou o alvo forem excluídos, que é justamente o
/// caso em que alguém vai querer lê-la. Os ids ficam só como pista.
model AuditLog {
  id Int @id @default(autoincrement())

  /// Quem praticou o ato, congelado no momento em que ele aconteceu.
  actorId   Int?
  actorName String
  actorRole String

  /// O que foi feito — ver AUDIT_ACTION em src/audit/audit.service.ts.
  action String

  /// Sobre quem/o quê, também congelado ("user" | "barter" | "unit" | …).
  targetType  String
  targetId    Int?
  targetLabel String

  /// Contexto curto e legível do ato (ex.: papel provisionado, decisão tomada).
  detail String?

  at DateTime @default(now())

  @@index([at])
  @@index([targetType, targetId])
}
