# Ambiente de teste (e2e): banco PRÓPRIO, isolado do de desenvolvimento — a
# suíte apaga e re-semeia a cada spec.
DATABASE_URL="postgresql://thiagopiccoli@localhost:5432/barter_test"
PORT=3334

# Os e2e fazem dezenas de logins legítimos em segundos: sem folga aqui o
# limite do /auth/login derrubaria a própria suíte.
LOGIN_RATE_LIMIT=10000
API_RATE_LIMIT=100000

# Custo do scrypt. O padrão (16) leva ~170ms por verificação de senha, de
# propósito — é o que torna caro quebrar um hash vazado. A suíte faz mais de
# cem logins, então aqui o custo cai para a suíte rodar em segundos.
# NUNCA use um valor baixo em produção: o servidor avisa na subida se você usar.
PASSWORD_COST=10
