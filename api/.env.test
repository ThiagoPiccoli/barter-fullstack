# Ambiente de teste (e2e): banco PRÓPRIO, isolado do de desenvolvimento — a
# suíte apaga e re-semeia a cada spec.
#
# A DATABASE_URL daqui é o PADRÃO, não a da máquina de ninguém. Ela já foi
# `postgresql://thiagopiccoli@localhost:5432/barter_test` — o usuário do
# notebook de quem escreveu —, e este arquivo é versionado: quem clonasse o
# repositório e seguisse o README (`npm run test:e2e`) recebia um erro de
# autenticação sobre um papel que não existe no cluster dele. O CI escapava por
# acidente, porque o DATABASE_URL do job vence o do arquivo.
#
# A precedência, do mais forte para o mais fraco:
#   1. variável já no AMBIENTE (é assim que o CI aponta para o Postgres dele);
#   2. .env.test.local — o seu, não versionado (está no .gitignore);
#   3. este arquivo.
#
# Se o seu cluster local não atende por `postgres:postgres`, crie o
# `.env.test.local` com uma linha:
#   DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/barter_test"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barter_test"
PORT=3334

# Os e2e fazem dezenas de logins legítimos em segundos: sem folga aqui o
# limite do /auth/login derrubaria a própria suíte.
LOGIN_RATE_LIMIT=10000
API_RATE_LIMIT=100000

# Custo do scrypt. O padrão (16) leva ~170ms por verificação de senha, de
# propósito — é o que torna caro quebrar um hash vazado. A suíte faz mais de
# cem logins, então aqui o custo cai para a suíte rodar em segundos.
# NUNCA use um valor baixo em produção: o servidor avisa na subida se você usar.
PASSWORD_COST=10
